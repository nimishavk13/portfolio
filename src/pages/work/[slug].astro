---
import Base from "../../layouts/Base.astro";
import CaseHero from "../../components/case/CaseHero.astro";
import SectionNav from "../../components/case/SectionNav.astro";
import Block from "../../components/case/Block.astro";
import NextProject from "../../components/case/NextProject.astro";
import { projects, getProject, nextProject } from "../../data/projects";
import type { CaseStudy } from "../../data/case-types";
import "@fontsource/baloo-2/600.css";
import "@fontsource/baloo-2/700.css";
import "@fontsource/baloo-2/800.css";
import "@fontsource/mali/500.css";
import "@fontsource/mali/600.css";
import "@fontsource/outfit/500.css";
import "@fontsource/outfit/600.css";
import "@fontsource/outfit/700.css";
import "@fontsource/nunito/500.css";
import "@fontsource/nunito/700.css";
import "@fontsource/nunito/800.css";
import "../../styles/case.css";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}
const mods = import.meta.glob<{ default: CaseStudy }>("../../data/cases/*.ts", { eager: true });
const { slug } = Astro.params as { slug: string };
const p = getProject(slug);
const cs = mods[`../../data/cases/${slug}.ts`].default;
const next = nextProject(slug);
const style = [
  `--p:${p.color}`, `--ps:${p.soft}`, `--pi:${p.ink}`,
  `--pp:${cs.theme.pop}`, `--pd:${cs.theme.deep}`, `--pt:${cs.theme.tint}`,
  `--pf:${cs.fonts.display}`, `--pb:${cs.fonts.body}`,
].join(";");
---
<Base title={`${p.title} · ${p.type} · Nimisha Vk`} description={`${p.title}: ${p.summary} ${p.type} by Nimisha Vk.`} image={p.image} theme={p.color}>
  <div class={`case case--${slug}`} style={style}>
    <CaseHero project={p} facts={cs.facts} />
    <SectionNav sections={cs.sections} />
    {cs.sections.map((s, i) => (
      <section class="cs" id={s.id} data-cs aria-labelledby={`${s.id}-h`}>
        <div class="wrap">
          <header class="cs__head">
            <h2 class="cs__title" id={`${s.id}-h`} data-reveal><i class="tab" aria-hidden="true"></i>{s.title}</h2>
            {s.sub && <p class="cs__sub" data-reveal style="--d:80ms"><span aria-hidden="true"></span>{s.sub}</p>}
          </header>
          <div class="cs__body">
            {s.blocks.map((b) => <Block block={b} slug={slug} />)}
          </div>
        </div>
      </section>
    ))}
  </div>
  <NextProject project={next} />
  <script>
    import { initCase } from "../../scripts/case";
    initCase();
  </script>
</Base>
