---
/*
  One project tile from "Selected work". The whole tile is a single link.
  `variant` picks the Figma layout:
    feature – Little Roots: wide image, title | divider | summary, arrow on the right
    tall    – Hormona: tall image, title + summary below, arrow bottom-right
    side    – Mentora / Yeola Paithani: image left, text column right
  Geometry comes from the parent (design px, see SelectedWork.astro).
*/
import type { Project } from "../data/projects";
interface Props {
  project: Project;
  variant: "feature" | "tall" | "side";
  style?: string;
  delay?: number;
  eager?: boolean;
}
const { project, variant, style = "", delay = 0, eager = false } = Astro.props;
---
<a class={`pcard pcard--${variant}`} href={`/work/${project.slug}`} style={`${style};--d:${delay}ms`} data-reveal="rise">
  <span class="pcard__media">
    <img src={project.cardImage} alt={project.cardAlt} loading={eager ? "eager" : "lazy"} decoding="async" />
  </span>
  <span class="pcard__body">
    <span class="pcard__title">{project.title}</span>
    {variant === "feature" && <span class="pcard__divider" aria-hidden="true"></span>}
    <span class="pcard__summary">{project.summary}</span>
  </span>
  <span class="pcard__arrow" aria-hidden="true">
    <svg viewBox="0 0 82 82"><rect x="1" y="1" width="80" height="80" rx="40" class="pcard__ring"/><path d="M24.12 41H57.88M44.55 54.33L57.88 41L44.55 27.68" class="pcard__chev"/></svg>
  </span>
  <span class="sr-only">– view case study</span>
</a>

<style>
  .pcard {
    position: absolute; display: block; color: inherit; text-decoration: none;
    font-family: var(--font-figtree);
    border-radius: calc(56 * var(--px));
  }
  .pcard__media {
    position: absolute; overflow: hidden; display: block;
    left: 0; top: 0; width: calc(var(--iw) * var(--px)); height: calc(var(--ih) * var(--px));
    border-radius: calc(var(--ir) * var(--px));
    background: #eef3fd;
    transform: translateZ(0);
  }
  .pcard__media img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }
  .pcard__body { position: absolute; display: block; }
  .pcard__title {
    display: block; font-weight: 800; color: #000; letter-spacing: -0.015em;
    font-size: calc(var(--ts) * var(--px)); line-height: calc(var(--tl) * var(--px));
  }
  .pcard__summary { display: block; color: var(--ink-soft); font-size: calc(var(--ss) * var(--px)); line-height: calc(44 * var(--px)); }
  .pcard__divider { display: block; background: var(--blue-ui); }
  .pcard__arrow {
    position: absolute; width: calc(var(--aw) * var(--px)); height: calc(var(--aw) * var(--px));
    left: calc(var(--ax) * var(--px)); top: calc(var(--ay) * var(--px));
  }
  .pcard__arrow svg { width: 100%; height: 100%; overflow: visible; }
  .pcard__ring { fill: #fff; stroke: var(--blue-ui); stroke-width: 2; transition: fill var(--dur-fast) var(--ease-out); }
  .pcard__chev {
    fill: none; stroke: var(--blue-arrow); stroke-width: 3.9; stroke-linecap: round; stroke-linejoin: round;
    transition: transform var(--dur-fast) var(--ease-out), stroke var(--dur-fast) var(--ease-out);
  }

  /* hover / focus: image eases in, arrow fills and nudges forward */
  .pcard:hover .pcard__media img, .pcard:focus-visible .pcard__media img { transform: scale(1.045); }
  .pcard:hover .pcard__ring, .pcard:focus-visible .pcard__ring { fill: var(--blue-ui); }
  .pcard:hover .pcard__chev, .pcard:focus-visible .pcard__chev { stroke: #fff; transform: translateX(4px); }
  .pcard:focus-visible { outline-offset: 10px; }

  /* feature: title | divider | summary on one line under the image */
  .pcard--feature .pcard__body { left: 0; top: calc((var(--ih) + 24) * var(--px)); display: flex; align-items: center; }
  .pcard--feature .pcard__divider { width: calc(2 * var(--px)); height: calc(77 * var(--px)); margin: 0 calc(51 * var(--px)) 0 calc(51 * var(--px)); }
  .pcard--feature .pcard__summary { font-size: calc(35 * var(--px)); }
  /* tall: text under the image */
  .pcard--tall .pcard__body { left: 0; top: calc((var(--ih) + 22) * var(--px)); }
  /* side: text column right of the image */
  .pcard--side .pcard__body { left: calc(626 * var(--px)); top: 0; width: calc(var(--bw) * var(--px)); }
  .pcard--side .pcard__summary { margin-top: calc(var(--sg, 12) * var(--px)); }

  @media (max-width: 1099px) {
    .pcard { position: relative; left: auto !important; top: auto !important; width: auto !important; height: auto !important; border-radius: 26px; }
    .pcard__media { position: relative; width: 100%; height: auto; aspect-ratio: var(--iw) / var(--ih); border-radius: 26px; }
    .pcard--feature .pcard__media { aspect-ratio: 1662 / 760; }
    .pcard__body { position: relative; left: auto !important; top: auto !important; width: auto !important; display: block !important; padding: 16px 70px 0 4px; }
    .pcard__title { font-size: clamp(28px, 8vw, 40px); line-height: 1.1; }
    .pcard__summary { font-size: 16px !important; line-height: 1.45; margin-top: 6px !important; }
    .pcard__divider { display: none !important; }
    .pcard__arrow { left: auto; right: 4px; top: auto; bottom: 0; width: 52px; height: 52px; }
  }
</style>
