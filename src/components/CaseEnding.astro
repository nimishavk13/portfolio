<style>
  .ending { overflow: hidden; }
  .ending__glow {
    width: calc(595 * var(--px)); height: calc(595 * var(--px));
    background: #1d59bb; filter: blur(calc(220 * var(--px)));
  }
  .ending__glow--tr { left: calc(1674 * var(--px)); top: calc(-190 * var(--px)); }
  .ending__glow--bl { left: calc(-350 * var(--px)); top: calc(665 * var(--px)); }
  .ending__text {
    text-align: center; font-weight: 400;
    font-size: calc(48 * var(--px)); line-height: 1.5;
  }
  .ending__text strong { color: var(--blue); font-weight: 700; }
  .ending__contacts {
    position: absolute; left: 0; right: 0; top: calc(var(--y) * var(--px));
    display: flex; justify-content: center; gap: calc(110 * var(--px));
    margin: 0; padding: 0; list-style: none;
  }
  .ending__contacts a {
    display: inline-flex; align-items: center; gap: calc(13 * var(--px));
    font-size: calc(24 * var(--px)); line-height: calc(36 * var(--px));
    text-decoration: none; color: #000;
    border-bottom: 2px solid transparent;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .ending__contacts a:hover { color: var(--blue); border-color: currentColor; }
  .ending__contacts svg { width: calc(24 * var(--px)); height: calc(24 * var(--px)); flex: none; transition: transform var(--dur-fast) var(--ease-out); }
  .ending__contacts img, .ending__li { width: calc(30 * var(--px)); height: calc(30 * var(--px)); flex: none; border-radius: calc(4 * var(--px)); }
  .ending__contacts a:hover svg { transform: rotate(-12deg) scale(1.08); }

  @media (max-width: 900px) {
    .ending { padding-block: 110px 120px; }
    .ending__glow { width: 70vw; height: 70vw; filter: blur(80px); }
    .ending__glow--tr { left: auto; right: -35vw; top: -25vw; }
    .ending__glow--bl { left: -35vw; top: auto; bottom: -30vw; }
    .ending__text { font-size: clamp(20px, 5.4vw, 30px); }
    .ending__contacts { position: static; margin-top: 48px; display: grid; gap: 6px; justify-items: center; }
    .ending__contacts a { min-height: 44px; font-size: 16px; gap: 10px; }
    .ending__contacts svg { width: 20px; height: 20px; }
    .ending__contacts img, .ending__li { width: 24px; height: 24px; }
  }
</style>
