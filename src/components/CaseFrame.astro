---
/*
  One Figma frame of a case study.

  ≥ 1180px  – the frame as designed: artwork (portfolio text removed) with the
              live text laid back on top at Figma's positions, sizes and fonts.
  < 1180px  – the same content re-flowed for reading: title, then cards,
              paragraphs and images in reading order.
  Visual frames (key screens, IA, design systems) show the full frame image;
  on smaller screens it pans sideways and opens full size on tap.

  Data: src/data/cases/<project>.json (generated by tools/build_cases.py).
*/
import type { CaseFrameData, Para, FrameImage } from "../data/case-types";
import CasePara from "./CasePara.astro";
interface Props { frame: CaseFrameData; index: number; projectTitle: string; accent: string }
const { frame: f, index, projectTitle, accent } = Astro.props;

const METRICS: Record<string, [number, number]> = {
  Poppins: [1.05, 0.35], Figtree: [0.95, 0.25], Parkinsans: [1.05, 0.35], "League Spartan": [0.7, 0.3],
};
const FAMILY: Record<string, string> = {
  Poppins: "var(--font-poppins)", Figtree: "var(--font-figtree)",
  Parkinsans: "'Parkinsans', var(--font-poppins)", "League Spartan": "'League Spartan', var(--font-poppins)",
};
const isCover = index === 0;
const titleText = f.title;
const HeadingTag = isCover ? "h1" : "h2";
const linkFor = (text: string) => f.links.find(([t]) => text.trim().toLowerCase() === t.trim().toLowerCase());

// ---------- reading order for the re-flowed view ----------
type Item = { kind: "para"; p: Para } | { kind: "img"; i: FrameImage } | { kind: "card"; c: number; items: Item[] };
const pos = (it: Item): [number, number] =>
  it.kind === "para" ? [it.p.y, it.p.x] : it.kind === "img" ? [it.i.y, it.i.x] : [f.cards[it.c].y, f.cards[it.c].x];
const order = (a: Item, b: Item) => {
  const [ay, ax] = pos(a), [by, bx] = pos(b);
  return Math.abs(ay - by) < 40 ? ax - bx : ay - by;
};
const isTitlePara = (p: Para) => p.size >= 55 && p.runs.map((r) => r.text).join("").trim() === titleText;
const titlePara = f.paras.find(isTitlePara);
const items: Item[] = [];
const inCard = new Map<number, Item[]>();
const push = (card: number | null, it: Item) => {
  if (card === null) items.push(it);
  else { if (!inCard.has(card)) inCard.set(card, []); inCard.get(card)!.push(it); }
};
f.paras.forEach((p) => { if (!isTitlePara(p)) push(p.card, { kind: "para", p }); });
f.images.forEach((i) => push(i.card, { kind: "img", i }));
for (const [c, list] of inCard) { list.sort(order); items.push({ kind: "card", c, items: list }); }
items.sort(order);

const cardBg = (c: (typeof f.cards)[number]) =>
  c.op < 1 ? `color-mix(in srgb, ${c.fill} ${Math.round(c.op * 100)}%, white)` : c.fill;
const altFor = () =>
  `${titleText} – ${projectTitle}` + (f.baked.length ? `: ${[...new Set(f.baked)].slice(0, 14).join(", ")}` : "");
---
<section class={`cf${f.visual ? " cf--visual" : ""}`} id={`f${f.id}`} aria-label={titleText || undefined}
  style={`--fh:${f.h};--bgc:${f.bg};--accent:${accent}`}>

  <div class="cf__desk">
    <img class="cf__art" src={`/img/cs/f${f.id}.webp`}
      srcset={`/img/cs/f${f.id}.webp 1920w, /img/cs/f${f.id}-2x.webp 2880w`} sizes="min(100vw, 1920px)"
      width="1920" height={Math.round(f.h)} alt={f.visual ? altFor() : ""}
      loading={index < 1 ? "eager" : "lazy"} decoding="async" fetchpriority={index < 1 ? "high" : "auto"} />
    {f.visual ? (
      <HeadingTag class="sr-only">{titleText}</HeadingTag>
    ) : (
      <div class="cf__text">
        {f.lines.map((l) => {
          const max = Math.max(...l.runs.map((r) => r.size));
          const [A, D] = METRICS[l.runs[0].fam] ?? [1, 0.3];
          const text = l.runs.map((r) => r.text).join("");
          const link = linkFor(text);
          const isTitle = text.trim() === titleText && max >= 55;
          const Tag = link ? "a" : isTitle ? HeadingTag : "span";
          return (
            <Tag class={`ln${link ? " ln--link" : ""}`} href={link?.[1]}
              target={link ? "_blank" : undefined} rel={link ? "noopener" : undefined}
              style={`left:calc(${l.x} * var(--px));top:calc(${(l.base - A * max).toFixed(1)} * var(--px));font-size:calc(${max} * var(--px));line-height:${A + D}`}>
              {l.runs.map((r) => (
                <span style={`font-family:${FAMILY[r.fam] ?? "inherit"};font-weight:${r.w};${r.it ? "font-style:italic;" : ""}color:${r.color};font-size:calc(${r.size} * var(--px))`}>{r.text}</span>
              ))}
              {link && <span class="sr-only"> (opens in a new tab)</span>}
            </Tag>
          );
        })}
      </div>
    )}
  </div>

  <div class="cf__flow">
    {isCover ? (
      <h1 class="cf__cover-title">
        {titlePara ? titlePara.runs.map((r) => <span style={`font-family:${FAMILY[r.fam] ?? "inherit"};font-weight:${r.w};color:${r.color}`}>{r.text}</span>) : titleText}
      </h1>
    ) : titleText && <h2 class="cf__h"><i aria-hidden="true"></i>{titleText}</h2>}
    {f.visual ? (
      <figure class="cf__pan">
        <div class="cf__pan-scroll" tabindex="0" role="region" aria-label={`${titleText}, scroll sideways to explore`}>
          <a href={`/img/cs/f${f.id}-2x.webp`} target="_blank" rel="noopener">
            <img src={`/img/cs/f${f.id}.webp`} width="1920" height={Math.round(f.h)} alt={altFor()}
              loading="lazy" decoding="async" style={`width:${f.h > 1500 ? 260 : 210}%`} />
          </a>
        </div>
        <figcaption>Swipe to explore · tap to open full size</figcaption>
      </figure>
    ) : (
      <div class="cf__items">
        {items.map((it) =>
          it.kind === "card" ? (
            <div class="cf__card" style={`background:${cardBg(f.cards[it.c])}`} data-reveal="rise">
              {it.items.map((x) =>
                x.kind === "para" ? <CasePara p={x.p} links={f.links} /> :
                x.kind === "img" ? <img class="cf__img" src={x.i.src} width={x.i.w} height={x.i.h} alt="" loading="lazy" decoding="async" /> : null)}
            </div>
          ) : it.kind === "para" ? (
            <CasePara p={it.p} links={f.links} />
          ) : (
            <img class="cf__img" src={it.i.src} width={it.i.w} height={it.i.h} alt="" loading="lazy" decoding="async" data-reveal="rise" />
          ))}
      </div>
    )}
  </div>
</section>

<style>
  .cf { position: relative; background: #fff; }
  .cf__desk { position: relative; max-width: 1920px; margin-inline: auto; height: calc(var(--fh) * var(--px)); overflow: hidden; }
  .cf__art { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cf__text { position: absolute; inset: 0; }
  .ln { position: absolute; display: block; white-space: pre; margin: 0; font-weight: 400; text-decoration: none; color: inherit; }
  .ln span { white-space: pre; }
  .ln--link span { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .ln--link:hover span, .ln--link:focus-visible span { text-decoration-thickness: 2px; }
  .cf__flow { display: none; }

  @media (max-width: 1179px) {
    .cf__desk { display: none; }
    .cf__flow { display: block; background: var(--bgc); padding: 52px var(--gutter) 40px; }
    .cf__flow > * { max-width: 760px; margin-inline: auto; }
    .cf__h {
      display: flex; align-items: center; gap: 12px;
      font-family: var(--font-poppins); font-weight: 700; font-size: clamp(24px, 6.4vw, 34px); line-height: 1.2;
      margin-bottom: 22px;
    }
    .cf__h i { width: 28px; height: 14px; border-radius: 0 14px 14px 0; background: var(--accent); margin-left: calc(-1 * var(--gutter)); flex: none; }
    .cf__cover-title { font-size: clamp(44px, 13vw, 64px); line-height: 1.05; margin: 14px 0 16px; letter-spacing: -0.01em; }
    .cf:first-of-type .cf__flow { padding-top: 96px; }
    .cf__items { display: grid; gap: 14px; }
    .cf__card { border-radius: 22px; padding: 20px 20px 10px; overflow: hidden; }
    .cf__card .cf__img { margin: 4px 0 12px; }
    .cf__img { width: 100%; height: auto; border-radius: 16px; }
    .cf__pan { margin: 0; }
    .cf__pan-scroll { overflow-x: auto; border-radius: 16px; background: #fff; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06); -webkit-overflow-scrolling: touch; }
    .cf__pan-scroll img { max-width: none; height: auto; display: block; }
    .cf__pan figcaption { margin-top: 10px; font-size: 13px; color: #555; text-align: center; }
  }
  @media (min-width: 700px) and (max-width: 1179px) {
    .cf__pan-scroll img { width: 100% !important; }
  }
</style>
