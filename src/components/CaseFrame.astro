---
/*
  One Figma frame of a case study.

  ≥ 1180px  the frame as designed: artwork (live text removed) with every Figma
            text box laid back on top at its exact position, font and size.
  < 1180px  the same text boxes re-flowed for reading: title, then cards,
            text and photos in reading order (recursive XY-cut, so columns read
            top-to-bottom).
  Visual frames (key screens, IA, design systems) show the full artwork; on
  smaller screens it pans sideways and opens full size on tap.

  Data: src/data/cases/<project>.json, generated by tools/build_cases.py.
*/
import type { CaseFrameData, TextNode, FrameImage } from "../data/case-types";
import FigmaText from "./FigmaText.astro";
interface Props { frame: CaseFrameData; index: number; projectTitle: string; accent: string }
const { frame: f, index, projectTitle, accent } = Astro.props;

const isCover = index === 0;
const nodeText = (n: TextNode) => n.lines.map((l) => l.runs.map((r) => r.text).join("")).join(" ").trim();
const titleNode = f.nodes.find((n) => n.size >= 55 && nodeText(n) === f.title);
const HeadingTag = isCover ? "h1" : "h2";

// ---------- reading order for the re-flowed view ----------
type Box = { x0: number; y0: number; x1: number; y1: number };
type Item = ({ kind: "text"; n: TextNode } | { kind: "img"; i: FrameImage } | { kind: "card"; c: number; items: Item[] }) & { b: Box };
const top: Item[] = [];
const inCard = new Map<number, Item[]>();
const push = (card: number | null, it: Item) => {
  if (card === null || card === undefined) top.push(it);
  else { if (!inCard.has(card)) inCard.set(card, []); inCard.get(card)!.push(it); }
};
f.nodes.forEach((n) => { if (n !== titleNode) push(n.card, { kind: "text", n, b: { x0: n.x, y0: n.y, x1: n.x + n.w, y1: n.y + n.h } }); });
// drop stacked copies of the same render (mockups exported as several overlapping layers)
const overlap = (a: FrameImage, b: FrameImage) => {
  const w = Math.min(a.x + a.w, b.x + b.w) - Math.max(a.x, b.x), h = Math.min(a.y + a.h, b.y + b.h) - Math.max(a.y, b.y);
  return w > 0 && h > 0 ? (w * h) / Math.min(a.w * a.h, b.w * b.h) : 0;
};
const imgs = [...f.images].sort((a, b) => b.w * b.h - a.w * a.h).filter((im, k, all) => !all.slice(0, k).some((o) => overlap(o, im) > 0.5));
imgs.forEach((i) => push(i.card, { kind: "img", i, b: { x0: i.x, y0: i.y, x1: i.x + i.w, y1: i.y + i.h } }));
const split = (list: Item[], axis: "x" | "y") => {
  const a0 = axis === "y" ? "y0" : "x0", a1 = axis === "y" ? "y1" : "x1";
  const sorted = [...list].sort((m, n) => m.b[a0] - n.b[a0]);
  const groups: Item[][] = [[sorted[0]]];
  let edge = sorted[0].b[a1], gap = -Infinity;
  for (const it of sorted.slice(1)) {
    if (it.b[a0] >= edge - 2) { gap = Math.max(gap, it.b[a0] - edge); groups.push([it]); }
    else groups[groups.length - 1].push(it);
    edge = Math.max(edge, it.b[a1]);
  }
  return { groups, gap };
};
// cut along whichever axis has the widest empty gap (columns beat rows that merely line up)
const xycut = (list: Item[]): Item[] => {
  if (list.length <= 1) return list;
  const ys = split(list, "y"), xs = split(list, "x");
  const best = xs.groups.length > 1 && (ys.groups.length < 2 || xs.gap > ys.gap * 1.5) ? xs : ys;
  if (best.groups.length > 1) return best.groups.flatMap(xycut);
  return [...list].sort((m, n) => m.b.y0 - n.b.y0 || m.b.x0 - n.b.x0);
};
for (const [c, list] of inCard) {
  const cd = f.cards[c];
  top.push({ kind: "card", c, items: xycut(list), b: { x0: cd.x, y0: cd.y, x1: cd.x + cd.w, y1: cd.y + cd.h } });
}
const items = xycut(top);
const cardBg = (c: (typeof f.cards)[number]) =>
  c.op < 1 ? `color-mix(in srgb, ${c.fill} ${Math.round(c.op * 100)}%, white)` : c.fill;
const alt = `${f.title} – ${projectTitle}`;
const imgMax = (w: number) => `max-width:min(100%, ${Math.round(Math.max(w * 1.3, 120))}px)`;
---
<section class={`cf${f.visual ? " cf--visual" : ""}`} id={`f${f.id}`} aria-label={f.title || undefined}
  style={`--fh:${f.h};--bgc:${f.bg};--accent:${accent}`}>

  <div class="cf__desk">
    <img class="cf__art" src={`/img/cs/f${f.id}.webp`}
      srcset={`/img/cs/f${f.id}.webp 1920w, /img/cs/f${f.id}-2x.webp 2880w`} sizes="min(100vw, 1920px)"
      width="1920" height={Math.round(f.h)} alt={f.visual ? alt : ""}
      loading={index < 1 ? "eager" : "lazy"} decoding="async" fetchpriority={index < 1 ? "high" : "auto"} />
    <div class="cf__text">
      {f.nodes.map((n) => <FigmaText node={n} mode="desk" tag={n === titleNode ? HeadingTag : undefined} />)}
    </div>
  </div>

  <div class="cf__flow">
    {titleNode && (isCover
      ? <div class="cf__cover"><FigmaText node={titleNode} mode="flow" tag="h1" /></div>
      : f.visual ? <h2 class="sr-only">{f.title}</h2> : <h2 class="cf__h"><i aria-hidden="true"></i>{f.title}</h2>)}
    {f.visual ? (
      <figure class="cf__pan">
        <div class="cf__pan-scroll" tabindex="0" role="region" aria-label={`${f.title}, scroll sideways to explore`}>
          <a href={`/img/cs/f${f.id}-2x.webp`} target="_blank" rel="noopener">
            <img src={`/img/cs/f${f.id}.webp`} width="1920" height={Math.round(f.h)} alt={alt}
              loading="lazy" decoding="async" style={`width:${f.h > 1500 ? 260 : 210}%`} />
          </a>
        </div>
        <figcaption>Swipe to explore · tap to open full size</figcaption>
      </figure>
    ) : (
      <div class="cf__items">
        {items.map((it) =>
          it.kind === "card" ? (
            <div class="cf__card" style={`background:${cardBg(f.cards[it.c])}`}>
              {it.items.map((x) =>
                x.kind === "text" ? <FigmaText node={x.n} mode="flow" /> :
                x.kind === "img" ? <img class="cf__img" src={x.i.src} width={x.i.w} height={x.i.h} alt="" loading="lazy" decoding="async" style={imgMax(x.i.w)} /> : null)}
            </div>
          ) : it.kind === "text" ? (
            <FigmaText node={it.n} mode="flow" />
          ) : (
            <img class="cf__img" src={it.i.src} width={it.i.w} height={it.i.h} alt="" loading="lazy" decoding="async" style={imgMax(it.i.w)} />
          ))}
      </div>
    )}
  </div>
</section>

<style>
  .cf { position: relative; background: #fff; }
  .cf__desk { position: relative; max-width: 1920px; margin-inline: auto; height: calc(var(--fh) * var(--px)); overflow: hidden; }
  .cf__art { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cf__text { position: absolute; inset: 0; }
  .cf__flow { display: none; }

  @media (max-width: 1179px) {
    .cf__desk { display: none; }
    .cf__flow { display: block; background: var(--bgc); padding: 52px var(--gutter) 40px; }
    .cf__flow > * { max-width: 760px; margin-inline: auto; }
    .cf:first-of-type .cf__flow { padding-top: 96px; }
    .cf__h {
      display: flex; align-items: center; gap: 12px;
      font-family: var(--font-poppins); font-weight: 700; font-size: clamp(24px, 6.4vw, 34px); line-height: 1.2;
      margin-bottom: 22px;
    }
    .cf__h i { width: 28px; height: 14px; border-radius: 0 14px 14px 0; background: var(--accent); margin-left: calc(-1 * var(--gutter)); flex: none; }
    .cf__cover :global(.ft) { margin: 6px 0 10px; }
    .cf__items { display: grid; gap: 12px; }
    .cf__items > :global(.ft) { margin: 0; }
    .cf__card { border-radius: 22px; padding: 20px 20px 8px; overflow: hidden; }
    .cf__card :global(.ft) { margin-bottom: 12px; }
    .cf__img { width: 100%; height: auto; border-radius: 16px; margin-inline: auto; display: block; }
    .cf__card .cf__img { margin-bottom: 12px; }
    .cf__pan { margin: 0; }
    .cf__pan-scroll { overflow-x: auto; border-radius: 16px; background: #fff; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06); -webkit-overflow-scrolling: touch; }
    .cf__pan-scroll img { max-width: none; height: auto; display: block; }
    .cf__pan figcaption { margin-top: 10px; font-size: 13px; color: #555; text-align: center; }
  }
  @media (min-width: 700px) and (max-width: 1179px) {
    .cf__pan-scroll img { width: 100% !important; }
  }
</style>
