---
// A paragraph / heading in the re-flowed (tablet & phone) view of a case-study frame.
import type { Para } from "../data/case-types";
interface Props { p: Para; links: [string, string][] }
const { p, links } = Astro.props;
const FAMILY: Record<string, string> = {
  Poppins: "var(--font-poppins)", Figtree: "var(--font-figtree)",
  Parkinsans: "'Parkinsans', var(--font-poppins)", "League Spartan": "'League Spartan', var(--font-poppins)",
};
const text = p.runs.map((r) => r.text).join("").trim();
const size = Math.round((0.42 * p.size + 8.5) * 10) / 10;
const Tag = p.size >= 30 && text.length < 70 ? "h3" : "p";
const link = links.find(([t]) => t.trim().toLowerCase() === text.toLowerCase());
---
{link ? (
  <p class="cp" style={`font-size:${size}px;text-align:${p.align}`}>
    <a href={link[1]} target="_blank" rel="noopener" class="cp__link">
      {p.runs.map((r) => <span style={`font-family:${FAMILY[r.fam] ?? "inherit"};font-weight:${r.w};color:${r.color}`}>{r.text}</span>)}
      <span class="sr-only"> (opens in a new tab)</span>
    </a>
  </p>
) : (
  <Tag class="cp" style={`font-size:${size}px;text-align:${p.align}`}>
    {p.runs.map((r) => (
      <span style={`font-family:${FAMILY[r.fam] ?? "inherit"};font-weight:${r.w};${r.it ? "font-style:italic;" : ""}color:${r.color};${Math.abs(r.size - p.size) > 2 ? `font-size:${Math.round((0.42 * r.size + 8.5) * 10) / 10}px;` : ""}`}>{r.text}</span>
    ))}
  </Tag>
)}

<style>
  .cp { margin: 0 0 0.55em; line-height: 1.45; font-weight: 400; overflow-wrap: anywhere; white-space: pre-line; }
  h3.cp { line-height: 1.2; margin-bottom: 0.4em; }
  .cp__link { display: inline-flex; min-height: 44px; align-items: center; }
  .cp__link span { text-decoration: underline; text-underline-offset: 0.18em; }
</style>
