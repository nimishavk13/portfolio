---
import { projects } from "../data/projects";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = path === "/";
const pre = isHome ? "" : "/";
---
<header class="nav" data-nav>
  <nav class="nav__inner" aria-label="Main">
    <a class="nav__name" href="/" aria-label="Nimisha Vk, home">
      <span class="nav__mark" aria-hidden="true">N</span>
      <span>Nimisha <b class="gw">Vk</b></span>
    </a>
    <ul class="nav__links" role="list">
      <li><a href={`${pre}#work`} data-nav-link="work">Work</a></li>
      <li><a href={`${pre}#process`} data-nav-link="process">Process</a></li>
      <li><a href={`${pre}#about`} data-nav-link="about">About</a></li>
      <li><a href={`${pre}#contact`} class="nav__cta">Let’s talk</a></li>
    </ul>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="sr-only">Menu</span><i></i><i></i>
    </button>
  </nav>
  <div class="menu" id="menu" hidden data-menu>
    <ul role="list">
      {projects.map((p, i) => (
        <li><a href={`/work/${p.slug}`} style={`--pc:${p.color}`}><small>0{i + 1}</small>{p.title}</a></li>
      ))}
    </ul>
    <ul role="list" class="menu__sec">
      <li><a href={`${pre}#process`}>Process</a></li>
      <li><a href={`${pre}#about`}>About</a></li>
      <li><a href={`${pre}#contact`}>Contact</a></li>
    </ul>
  </div>
</header>

<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 60; padding: 14px var(--gx); pointer-events: none; transition: transform 420ms var(--ease-out); }
  .nav.is-hidden { transform: translateY(-120%); }
  .nav__inner {
    pointer-events: auto; position: relative; z-index: 2;
    max-width: var(--wrap); margin-inline: auto; height: 56px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 0 8px 0 10px; border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.86);
    -webkit-backdrop-filter: saturate(1.4) blur(14px); backdrop-filter: saturate(1.4) blur(14px);
    box-shadow: 0 0 0 1px rgba(29, 89, 187, 0.1), 0 10px 30px -18px rgba(29, 89, 187, 0.45);
  }
  .nav__name { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font: 700 17px/1 var(--f-head); color: var(--c-ink); letter-spacing: -0.01em; }
  .nav__mark { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: var(--grad-card); color: #fff; font-size: 16px; transition: transform 500ms var(--ease-out); }
  .nav__name:hover .nav__mark { transform: rotate(-12deg) scale(1.06); }
  .nav__links { display: flex; align-items: center; gap: 2px; list-style: none; }
  .nav__links a {
    position: relative; display: inline-flex; align-items: center; min-height: 42px; padding: 0 16px;
    border-radius: var(--r-pill); text-decoration: none; font: 500 15px/1 var(--f-head); color: var(--c-text);
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast);
  }
  .nav__links a:not(.nav__cta):hover { background: var(--c-wash); }
  .nav__links a[aria-current="true"] { color: var(--c-blue); }
  .nav__links a[aria-current="true"]::after { content: ""; position: absolute; left: 50%; bottom: 6px; width: 5px; height: 5px; margin-left: -2.5px; border-radius: 50%; background: var(--c-blue); }
  .nav__cta { background: var(--c-blue); color: #fff !important; margin-left: 6px; }
  .nav__cta:hover { background: #174ea7; }
  .nav__toggle { display: none; width: 44px; height: 44px; border: 0; border-radius: 50%; background: var(--c-blue); cursor: pointer; position: relative; }
  .nav__toggle i { position: absolute; left: 13px; right: 13px; height: 2px; background: #fff; border-radius: 2px; transition: transform var(--dur-fast) var(--ease-out); }
  .nav__toggle i:first-of-type { top: 17px; } .nav__toggle i:last-of-type { top: 25px; }
  .nav__toggle[aria-expanded="true"] i:first-of-type { transform: translateY(4px) rotate(45deg); }
  .nav__toggle[aria-expanded="true"] i:last-of-type { transform: translateY(-4px) rotate(-45deg); }
  .menu {
    pointer-events: auto; position: fixed; inset: 0; z-index: 1; background: #fff;
    padding: calc(var(--nav-h) + 24px) var(--gx) 32px; display: flex; flex-direction: column; justify-content: space-between; overflow-y: auto;
  }
  .menu[hidden] { display: none; }
  .menu ul { list-style: none; display: grid; gap: 4px; }
  .menu a { display: flex; align-items: baseline; gap: 12px; text-decoration: none; font: 700 clamp(30px, 9vw, 44px)/1.15 var(--f-head); color: var(--c-ink); padding: 6px 0; }
  .menu a small { font: 600 13px var(--f-body); color: var(--pc, var(--c-blue)); }
  .menu__sec a { font-size: 20px; font-weight: 500; color: var(--c-muted); }
  @media (max-width: 760px) {
    .nav__links { display: none; }
    .nav__toggle { display: block; }
  }
</style>
