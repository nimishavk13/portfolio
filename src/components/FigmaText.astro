---
/*
  Renders one Figma text box with its exact segments.
  mode="desk": absolutely positioned on the 1920 canvas, Figma sizes in design px.
  mode="flow": in normal flow for tablets/phones, sizes scaled down for reading.
*/
import type { TextNode, Run } from "../data/case-types";
interface Props { node: TextNode; mode: "desk" | "flow"; tag?: string }
const { node: n, mode, tag } = Astro.props;

const FAMILY: Record<string, string> = {
  Poppins: "var(--font-poppins)", Figtree: "var(--font-figtree)",
  Parkinsans: "'Parkinsans', var(--font-poppins)", "League Spartan": "'League Spartan', var(--font-poppins)",
};
const flowSize = (s: number) => Math.round((0.36 * s + 9.5) * 10) / 10; // 19→16.3, 24→18.1, 40→23.9, 60→31.1, 96→44
const px = (v: number) => (mode === "desk" ? `calc(${v} * var(--px))` : `${flowSize(v)}px`);
// a one-line box with auto line height: Figma's box height *is* the line height
const oneLine = n.lines.length === 1 && n.h < n.size * 1.9;
const lineHeight = (r: Run) => {
  if (r.lh === "a") return mode === "desk" && oneLine ? `calc(${n.h} * var(--px))` : "normal";
  if (typeof r.lh === "number") return mode === "desk" ? `calc(${r.lh} * var(--px))` : `${Math.max(r.lh / r.size, 1.2).toFixed(3)}`;
  const v = parseFloat(r.lh as string) / 100;
  return `${mode === "flow" ? Math.max(v, 1.3) : v}`;
};
const letter = (r: Run) => {
  if (!r.ls) return "normal";
  if (typeof r.ls === "string") return `${parseFloat(r.ls) / 100}em`;
  return `${(r.ls / r.size).toFixed(4)}em`;
};
const runStyle = (r: Run) =>
  `font-family:${FAMILY[r.fam] ?? "inherit"};font-weight:${r.w};${r.it ? "font-style:italic;" : ""}` +
  `color:${r.color};font-size:${px(r.size)};letter-spacing:${letter(r)}` +
  // Figma's Spartan sits higher in its line box than the web League Spartan
  (r.fam === "League Spartan" ? ";position:relative;top:-0.2em" : "");
const first = n.lines[0]?.runs[0];
const gapRun = n.lines.find((l) => l.runs.length)?.runs[0];
const boxStyle = mode === "desk"
  ? `left:calc(${n.x} * var(--px));top:calc(${n.y} * var(--px));` +
    (n.resize === "W" ? "white-space:pre;" : `width:calc(${n.w} * var(--px));`) +
    `text-align:${n.align};line-height:${first ? lineHeight(first) : "normal"}`
  : `text-align:${n.align === "justify" ? "left" : n.align};line-height:${first && first.lh !== "a" ? lineHeight(first) : "1.45"}`;
// phones: collapse the space-padding Figma uses to line up "Name : …" columns
const clean = (t: string) => (mode === "flow" ? t.replace(/ {2,}/g, " ") : t);
const Tag = (n.href ? "a" : tag ?? (mode === "flow" ? "p" : "div")) as any;
const text = n.lines.map((l) => l.runs.map((r) => r.text).join("")).join(" ").trim();
---
<Tag class={`ft ft--${mode}${n.href ? " ft--link" : ""}`} style={boxStyle}
  href={n.href} target={n.href ? "_blank" : undefined} rel={n.href ? "noopener" : undefined}>
  {n.lines.map((l) =>
    l.runs.length === 0 ? (
      mode === "desk" && gapRun
        ? <span class="ft__line" aria-hidden="true" style={`line-height:${lineHeight(gapRun)};font-size:${px(gapRun.size)}`}>{"\u200b"}</span>
        : <span class="ft__gap" aria-hidden="true"></span>
    ) : (
      <span class={`ft__line${l.list ? " ft__li" : ""}`} style={`line-height:${lineHeight(l.runs[0])};color:${l.runs[0].color};font-size:${px(l.runs[0].size)}`}>
        {l.runs.map((r) => <span style={runStyle(r)}>{clean(r.text)}</span>)}
      </span>
    ))}
  {n.href && <span class="sr-only"> (opens in a new tab)</span>}
</Tag>

<style>
  .ft { margin: 0; font-weight: 400; text-decoration: none; color: inherit; }
  .ft--desk { position: absolute; white-space: pre-wrap; }
  .ft--flow { position: relative; white-space: pre-wrap; overflow-wrap: anywhere; margin-bottom: 0.6em; }
  .ft__line { display: block; }
  .ft--desk .ft__line { white-space: inherit; }
  .ft__gap { display: block; height: 0.6em; }
  .ft__li { position: relative; padding-left: 1.05em; }
  .ft__li::before { content: "•"; position: absolute; left: 0.2em; color: inherit; }
  .ft--link span { text-decoration: underline; text-underline-offset: 0.18em; text-decoration-thickness: 1px; }
  .ft--link:hover span, .ft--link:focus-visible span { text-decoration-thickness: 2px; }
  .ft--flow.ft--link { display: inline-flex; flex-direction: column; min-height: 44px; justify-content: center; }
</style>
