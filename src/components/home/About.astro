---
/* "About me", built to match her About slide: blue Education card, light Skills card with chips and the blue cursor, dark Tools card. */
const soft = ["Problem Solving", "Critical Thinking", "Communication", "Collaboration", "Empathy", "Attention to Detail", "Conflict Management", "Adaptability"];
const hard = ["User Research", "Usability Testing", "Journey Mapping", "Personas", "Information Architecture", "Wireframing", "Interaction Design", "Prototyping", "Card Sorting"];
const tools = [["Figma", "tool-figma"], ["Illustrator", "tool-illustrator"], ["Photoshop", "tool-photoshop"], ["Premiere Pro", "tool-premiere"], ["In Design", "tool-indesign"], ["Miro", "tool-miro"]];
---
<section class="about" id="about" aria-labelledby="about-title" data-section="about">
  <span class="about__wash" aria-hidden="true"></span>
  <div class="wrap">
    <h2 class="about__title" id="about-title" data-about-title><span>About</span> <span class="gw">me</span></h2>
    <div class="trio">
      <article class="edu" data-panel>
        <h3>Education</h3>
        <div class="edu__band">
          <p>Undergraduate (Pursuing)</p>
          <p class="edu__b">Bachelor of Design –<br />User Experience Design</p>
          <p>Symbiosis Institute of Design, Pune</p>
          <p>2023 – 2027</p>
        </div>
        <hr />
        <div class="edu__sch">
          <p>Schooling</p>
          <p class="edu__b">Higher secondary – Science (CBSE)</p>
          <p>Blossom Public School, Tathawade</p>
          <p>2022 – 2023</p>
        </div>
      </article>

      <article class="skills" data-panel>
        <h3>Skills</h3>
        <h4><i aria-hidden="true"></i>Soft skills</h4>
        <ul role="list">{soft.map((s) => <li data-chip>{s}</li>)}</ul>
        <hr />
        <h4><i aria-hidden="true"></i>Hard skills</h4>
        <ul role="list">{hard.map((s) => <li data-chip>{s}</li>)}</ul>
        <svg class="skills__cursor" viewBox="0 0 48 48" aria-hidden="true" data-cursor><path d="M3 5 46 20 26 26 19 46Z" /></svg>
      </article>

      <article class="tools" data-panel>
        <h3>Tools</h3>
        <ul role="list">
          {tools.map(([n, f]) => <li data-tool><img src={`/img/home/${f}.webp`} alt="" width="72" height="72" loading="lazy" /><span>{n}</span></li>)}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .about { position: relative; overflow: hidden; padding-block: var(--section); }
  .about__wash { position: absolute; right: 0; top: 0; width: 46vw; height: 32vw; pointer-events: none; background: radial-gradient(80% 90% at 100% 0%, rgba(51, 110, 249, 0.6), rgba(118, 185, 255, 0.28) 45%, rgba(255, 255, 255, 0) 80%); }
  .about__title { position: relative; font: 800 clamp(44px, 5.6vw, 80px)/1 var(--f-head); letter-spacing: -0.035em; margin-bottom: clamp(28px, 3.4vw, 48px); }
  .about__title span { display: inline-block; }
  .trio { position: relative; display: grid; grid-template-columns: 36fr 30fr 26fr; gap: clamp(14px, 1.6vw, 22px); align-items: stretch; }
  .trio h3 { font: 700 clamp(26px, 2.6vw, 38px)/1.1 var(--f-head); }

  .edu { position: relative; overflow: hidden; display: flex; flex-direction: column; padding: clamp(28px, 2.8vw, 40px) 0 clamp(28px, 2.8vw, 40px); border-radius: clamp(22px, 2vw, 30px); color: #fff; background: linear-gradient(170deg, #1f5fcc 0%, #1a4fa8 34%, #123a7e 66%, #0e2a5c 100%); }
  .edu::before { content: ""; position: absolute; right: -10%; top: -20%; width: 70%; height: 60%; background: radial-gradient(closest-side, rgba(118, 185, 255, 0.28), rgba(118, 185, 255, 0)); }
  .edu h3 { color: #fff; padding-inline: clamp(24px, 2.6vw, 36px); position: relative; }
  .edu__band { position: relative; margin-top: clamp(16px, 1.6vw, 22px); padding: 16px clamp(24px, 2.6vw, 36px) 18px; background: rgba(255, 255, 255, 0.06); }
  .edu p { font: 400 clamp(15px, 1.25vw, 18px)/1.5 var(--f-head); }
  .edu .edu__b { font-weight: 700; line-height: 1.35; margin: 2px 0; }
  .edu hr { border: 0; height: 1.5px; background: rgba(255, 255, 255, 0.85); margin: 18px clamp(32px, 3.6vw, 48px); }
  .edu__sch { padding-inline: clamp(24px, 2.6vw, 36px); }

  .skills { position: relative; padding: clamp(28px, 2.8vw, 40px) clamp(22px, 2.4vw, 32px); border-radius: clamp(22px, 2vw, 30px); background: #d3ddf1; }
  .skills h3 { color: var(--c-ink); margin-bottom: clamp(18px, 2vw, 26px); }
  .skills h4 { display: flex; align-items: center; gap: 8px; font: 700 clamp(16px, 1.3vw, 19px)/1 var(--f-head); color: var(--c-ink); margin-bottom: 12px; }
  .skills h4 i { width: 12px; height: 12px; border-radius: 50%; background: var(--c-blue); }
  .skills ul { list-style: none; display: flex; flex-wrap: wrap; gap: 7px 8px; }
  .skills li { padding: 5px 14px; border-radius: var(--r-pill); background: #fff; font: 400 12.5px/1.3 var(--f-head); color: var(--c-blue); transition: background var(--dur-fast), color var(--dur-fast), transform var(--dur-fast) var(--ease-out); }
  .skills li:hover { background: var(--c-blue); color: #fff; transform: translateY(-2px); }
  .skills hr { border: 0; height: 1.5px; background: var(--c-blue); opacity: 0.75; margin: 24px 8px; }
  .skills__cursor { position: absolute; right: 22px; bottom: -22px; width: clamp(38px, 3.4vw, 50px); fill: var(--c-blue); rotate: 4deg; }

  .tools { position: relative; overflow: hidden; padding: clamp(28px, 2.8vw, 40px) clamp(22px, 2.4vw, 32px); border-radius: clamp(22px, 2vw, 30px); color: #fff; background: radial-gradient(70% 55% at 0% 72%, rgba(42, 86, 170, 0.75), rgba(16, 24, 43, 0) 70%), radial-gradient(60% 40% at 100% 10%, rgba(42, 70, 130, 0.5), rgba(16, 24, 43, 0) 70%), #121a2c; }
  .tools h3 { color: #fff; margin-bottom: clamp(18px, 2vw, 26px); }
  .tools ul { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .tools li { display: grid; justify-items: center; gap: 10px; padding: 16px 8px 12px; border-radius: 14px; background: rgba(255, 255, 255, 0.05); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.09); font: 400 13px/1 var(--f-head); transition: transform 400ms var(--ease-out), background 400ms; }
  .tools li:hover { transform: translateY(-4px); background: rgba(255, 255, 255, 0.1); }
  .tools img { width: clamp(44px, 3.6vw, 56px); height: auto; aspect-ratio: 1; border-radius: 10px; }

  @media (max-width: 1000px) { .trio { grid-template-columns: 1fr 1fr; } .tools { grid-column: span 2; } .tools ul { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .trio { grid-template-columns: 1fr; } .tools { grid-column: auto; } .tools ul { grid-template-columns: repeat(3, minmax(0, 1fr)); } .skills { margin-bottom: 10px; } }
</style>
