---
/* Closing slide (PDF p.56): the line, then the three ways to reach her. */
const EMAIL = "nimishavkattutharayil@gmail.com";
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="contact__wash" aria-hidden="true"></div>
  <div class="wrap contact__in">
    <p class="contact__pre" data-reveal="rise">This is just the beginning.<br />I’m continuously learning, refining, and designing with purpose.</p>
    <h2 id="contact-title" class="contact__title" data-reveal="rise" style="--d:100ms">If this work speaks to you, <span class="gw">I’d be glad to connect.</span></h2>

    <ul class="links" data-reveal="rise" style="--d:200ms">
      <li class="links__mail">
        <a href={`mailto:${EMAIL}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8"/></svg>
          <span>{EMAIL}</span>
        </a>
        <button type="button" class="copy" data-copy={EMAIL}>Copy</button>
      </li>
      <li><a href="https://www.behance.net/nimishavk" target="_blank" rel="noopener"><b class="be" aria-hidden="true">Bē</b><span>Behance</span><span class="sr-only">(opens in a new tab)</span></a></li>
      <li><a href="https://www.linkedin.com/in/nimisha-vijayraj" target="_blank" rel="noopener"><b class="in" aria-hidden="true">in</b><span>LinkedIn</span><span class="sr-only">(opens in a new tab)</span></a></li>
    </ul>
  </div>
</section>

<style>
  .contact { position: relative; overflow: hidden; padding-block: var(--section) calc(var(--section) * 1.1); text-align: center; }
  .contact__wash { position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(34vw 30vw at 100% 0%, rgba(29, 89, 187, 0.5), rgba(118, 185, 255, 0.15) 50%, rgba(255, 255, 255, 0) 75%),
      radial-gradient(34vw 30vw at 0% 100%, rgba(29, 89, 187, 0.5), rgba(118, 185, 255, 0.15) 50%, rgba(255, 255, 255, 0) 75%); }
  .contact__in { position: relative; }
  .contact__pre { font: 400 var(--fs-lead) / 1.6 var(--f-head); color: var(--c-ink); }
  .contact__title { font: 700 clamp(28px, 3.4vw, 44px) / 1.2 var(--f-head); letter-spacing: -0.015em; color: var(--c-blue); max-width: 22em; margin: var(--s-5) auto 0; text-wrap: balance; }
  .contact__title .gw { white-space: nowrap; }
  .links { list-style: none; padding: 0; margin: var(--s-8) 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-4); }
  .links li { display: flex; align-items: center; background: #fff; border-radius: var(--r-pill); box-shadow: 0 0 0 1px var(--c-line), var(--shadow-card); }
  .links a { display: inline-flex; align-items: center; gap: var(--s-3); padding: 14px 22px; font: 500 16px/1 var(--f-head); color: var(--c-ink); text-decoration: none; border-radius: var(--r-pill); transition: color 280ms var(--ease-out); }
  .links a:hover { color: var(--c-blue-ui); }
  .links svg { width: 20px; height: 20px; fill: none; stroke: var(--c-blue); stroke-width: 2; stroke-linecap: round; }
  .be, .in { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 5px; background: #1769ff; color: #fff; font: 700 12px/1 var(--f-head); }
  .in { background: #0a66c2; }
  .copy { border: 0; background: var(--c-wash); color: var(--c-blue); font: 600 13px/1 var(--f-head); padding: 10px 14px; margin-right: 6px; border-radius: var(--r-pill); cursor: pointer; transition: background 280ms var(--ease-out); }
  .copy:hover { background: var(--c-mist); }
  @media (max-width: 520px) { .links a { padding: 14px 16px; font-size: 14px; } .contact__title .gw { white-space: normal; } }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((b) => {
    b.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = "Copied"; }
      catch { b.textContent = "Select the email"; }
      setTimeout(() => (b.textContent = "Copy"), 1800);
    });
  });
</script>
