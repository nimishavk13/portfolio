---
/* Opening section — her "Introduction" slide (PDF p.2) rebuilt for the web. */
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__wash" aria-hidden="true"></div>
  <svg class="hero__arc" viewBox="0 0 600 600" aria-hidden="true"><circle cx="300" cy="300" r="298" /></svg>

  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="pill-label" data-reveal="rise">Nimisha VK · UI/UX Designer</p>
      <h1 id="hero-title" class="hero__title" data-reveal="rise" style="--d:80ms">
        I am <span class="gw">Nimisha</span>
      </h1>
      <p class="hero__lede" data-reveal="rise" style="--d:160ms">
        an <strong>emerging UX designer</strong> who loves breaking down messy problems and turning them into{" "}
        <strong>seamless, intuitive experiences</strong> using <strong>creative thinking</strong> and{" "}
        <strong>AI tools</strong> to bring ideas to life.
      </p>
      <p class="hero__sign" data-reveal="rise" style="--d:240ms">Let’s build something impactful together.</p>
      <a class="hero__scroll" href="#work" data-reveal="rise" style="--d:320ms">
        <span>See selected work</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 3v13M4 10l6 6 6-6" /></svg>
      </a>
    </div>

    <figure class="hero__photo" data-reveal="from-right" style="--d:120ms">
      <span class="hero__badge" aria-hidden="true">UX</span>
      <img src="/img/home/nimisha-photo.webp" width="1330" height="1546"
        alt="Nimisha smiling, resting her chin on her hand in a café full of hanging plants"
        fetchpriority="high" decoding="async" />
      <figcaption class="hero__loc"><span>Based in</span>Pune, India</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(40px, 6vw, 80px) var(--section); }
  .hero__wash {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(48vw 38vw at -6% -10%, rgba(29, 89, 187, 0.55), rgba(118, 185, 255, 0.18) 45%, rgba(255, 255, 255, 0) 72%),
      radial-gradient(34vw 30vw at 104% 96%, rgba(118, 185, 255, 0.28), rgba(255, 255, 255, 0) 70%);
  }
  .hero__arc {
    position: absolute; width: clamp(360px, 42vw, 620px); right: -14vw; top: -18vw;
    fill: none; stroke: rgba(29, 89, 187, 0.22); stroke-width: 1.5; pointer-events: none;
  }
  .hero__grid {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.85fr);
    gap: clamp(32px, 6vw, 96px); align-items: center;
  }
  .hero__title {
    font: 700 var(--fs-hero) / 1 var(--f-head); letter-spacing: -0.025em;
    color: var(--c-ink); margin: var(--s-5) 0 var(--s-5);
  }
  .hero__lede {
    font: 400 var(--fs-lead) / 1.6 var(--f-head); color: var(--c-ink); max-width: 34em;
  }
  .hero__lede strong { font-weight: 700; color: var(--c-blue); }
  .hero__sign { margin-top: var(--s-5); font: 700 clamp(19px, 1.7vw, 24px) / 1.3 var(--f-head); color: var(--c-ink); }

  .hero__scroll {
    display: inline-flex; align-items: center; gap: var(--s-3); margin-top: var(--s-7);
    font: 600 15px/1 var(--f-head); color: var(--c-blue); text-decoration: none;
    padding: 14px 22px; border-radius: var(--r-pill); background: var(--c-white);
    box-shadow: 0 0 0 1.5px rgba(29, 89, 187, 0.25), var(--shadow-soft);
    transition: box-shadow 280ms var(--ease-out), transform 280ms var(--ease-out);
  }
  .hero__scroll svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .hero__scroll:hover { transform: translateY(-2px); box-shadow: 0 0 0 1.5px var(--c-blue-ui), var(--shadow-soft); }
  .hero__scroll:hover svg { animation: nudge 900ms var(--ease-out) infinite; }
  @keyframes nudge { 50% { transform: translateY(3px); } }

  .hero__photo { position: relative; margin: 0; justify-self: end; width: min(100%, 440px); }
  .hero__photo img {
    width: 100%; height: auto; aspect-ratio: 4 / 4.6; object-fit: cover; border-radius: var(--r-lg);
    box-shadow: 0 30px 70px -30px rgba(29, 89, 187, 0.55), 0 0 0 1px rgba(29, 89, 187, 0.06);
  }
  .hero__badge {
    position: absolute; z-index: 2; right: -18px; top: -22px;
    width: 76px; height: 76px; border-radius: 18px; display: grid; place-items: center;
    background: linear-gradient(145deg, #3a7bff, #1a3f99); color: #fff;
    font: 700 26px/1 var(--f-head); transform: rotate(-14deg);
    box-shadow: 0 14px 28px -10px rgba(29, 89, 187, 0.7);
  }
  .hero__loc {
    position: absolute; z-index: 2; left: -40px; bottom: 36px;
    background: var(--c-white); border-radius: var(--r-sm); padding: 12px 18px;
    font: 400 15px/1.4 var(--f-head); color: var(--c-ink);
    box-shadow: 0 16px 34px -14px rgba(11, 11, 15, 0.3);
  }
  .hero__loc span { display: block; color: var(--c-blue); font-size: 14px; }

  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__photo { justify-self: start; width: min(100%, 360px); margin-top: var(--s-4); margin-left: 24px; }
    .hero__loc { left: -24px; }
    .hero__badge { right: -10px; width: 62px; height: 62px; font-size: 22px; }
  }
</style>
