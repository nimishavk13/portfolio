---
/* "Design Process" — PDF p.5: five staggered cards joined by small curved links. */
const steps = [
  { n: "01", t: "Empathize", d: "Understand people and context.", i: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>` },
  { n: "02", t: "Define", d: "Frame the right problem.", i: `<circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2.5"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>` },
  { n: "03", t: "Ideate", d: "Explore and shape ideas.", i: `<path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2z"/>` },
  { n: "04", t: "Prototype", d: "Make ideas tangible.", i: `<path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="m2 17 10 5 10-5M2 12l10 5 10-5"/>` },
  { n: "05", t: "Test", d: "Evaluate and improve.", i: `<rect x="3" y="3" width="18" height="18" rx="4"/><path d="m8 12 3 3 5-6"/>` },
];
---
<section class="process" aria-labelledby="process-title">
  <div class="wrap">
    <h2 id="process-title" class="sec-title" data-reveal="rise">Design <span class="gw">Process</span></h2>
    <ol class="steps">
      {steps.map((s, k) => (
        <li class={`step ${k % 2 ? "step--low" : ""}`} data-reveal="rise" style={`--d:${k * 90}ms`}>
          <span class="step__icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.i} /></span>
          <span class="step__n">{s.n} —</span>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { padding-block: var(--s-6) var(--section); }
  .steps { list-style: none; margin: var(--s-7) 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--s-5); }
  .step {
    position: relative; background: var(--c-mist); border-radius: var(--r-lg);
    padding: var(--s-5) var(--s-5) var(--s-6);
    transition: transform 400ms var(--ease-out), box-shadow 400ms var(--ease-out);
  }
  .step--low { margin-top: var(--s-9); }
  .step:hover { transform: translateY(-6px); box-shadow: var(--shadow-soft); }
  /* the small curved link + dots between neighbouring cards (her slide's connector) */
  .step:not(:last-child)::after {
    content: ""; position: absolute; top: 58%; right: calc(-1 * var(--s-5) - 2px); width: calc(var(--s-5) + 4px); height: 36px;
    border: 1.5px solid #2c5ca3; border-color: #2c5ca3 transparent transparent transparent; border-radius: 50%;
  }
  .step--low:not(:last-child)::after { top: 22%; transform: scaleY(-1); }
  .step__icon { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; background: rgba(255, 255, 255, 0.55); margin-bottom: var(--s-5); }
  .step__icon svg { width: 26px; height: 26px; fill: none; stroke: #10215a; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .step__n { font: 700 16px/1 var(--f-head); color: #2c5ca3; }
  .step h3 { font: 700 clamp(20px, 1.7vw, 24px) / 1.2 var(--f-head); margin: 6px 0 6px; color: var(--c-ink); }
  .step p { font: 400 15px/1.45 var(--f-head); color: var(--c-muted); }

  @media (max-width: 1000px) {
    .steps { grid-template-columns: 1fr 1fr; }
    .step--low { margin-top: 0; }
    .step:not(:last-child)::after { display: none; }
  }
  @media (max-width: 480px) { .steps { grid-template-columns: 1fr; } }
</style>
