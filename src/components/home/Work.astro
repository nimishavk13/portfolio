---
/* Selected work as an editorial list: each project gets a large framed image and its own colour, alternating sides. */
import { projects } from "../../data/projects";
---
<section class="work" id="work" aria-labelledby="work-title" data-section="work">
  <div class="wrap">
    <div class="work__head">
      <h2 class="work__title" id="work-title" data-reveal>Selected <span class="gw">work</span></h2>
      <p class="work__intro" data-reveal style="--d:120ms">Four projects, from a gardening kit for children to a trusted home for a 2,000-year-old craft.</p>
    </div>

    <nav class="windex" aria-label="Projects in this list" data-windex>
      <p class="windex__count"><b data-windex-n>01</b><span>/ 0{projects.length}</span></p>
      <ol role="list">
        {projects.map((p, i) => (
          <li><a href={`#p-${p.slug}`} style={`--pc:${p.color};--ps:${p.soft}`} data-windex-link={i} aria-current={i === 0 ? "true" : "false"}><i aria-hidden="true"></i>{p.title}</a></li>
        ))}
      </ol>
      <span class="windex__bar" aria-hidden="true"><span data-windex-bar></span></span>
    </nav>

    <ol class="rows" role="list" data-rows>
      {projects.map((p, i) => (
        <li class={`row${i % 2 ? " row--flip" : ""}`} id={`p-${p.slug}`} data-row style={`--pc:${p.color};--ps:${p.soft};--pi:${p.ink}`}>
          <a class="row__media" href={`/work/${p.slug}`} tabindex="-1" aria-hidden="true" data-row-media>
            <span class="row__frame" data-row-frame><img src={p.image} alt="" width="1400" height="900" loading="lazy" decoding="async" data-row-img /></span>
            <span class="row__lens" data-row-lens></span>
            <span class="row__dot" data-row-dot></span>
          </a>
          <div class="row__copy" data-row-copy>
            <p class="row__num"><span>0{p.n}</span> Project {p.n} : {p.kicker}</p>
            <h3 class="row__title"><a href={`/work/${p.slug}`}>{p.title}</a></h3>
            <ul class="row__meta" role="list">{p.meta.map((m) => <li>{m}</li>)}</ul>
            <p class="row__text">{p.summary}</p>
            <a class="row__cta" href={`/work/${p.slug}`}>
              <span>View {p.type.toLowerCase()}</span>
              <span class="arrow-btn" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span class="sr-only">: {p.title}</span>
            </a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .work { padding-block: var(--section); }
  .work__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 48px; margin-bottom: 28px; }
  .work__title { font: 800 clamp(44px, 5.6vw, 80px)/1 var(--f-head); letter-spacing: -0.035em; }
  .work__intro { max-width: 26em; font: 400 var(--fs-lead)/1.55 var(--f-head); color: var(--c-muted); }

  /* sticky index: shows it's a list of four and where you are in it */
  .windex { position: sticky; z-index: 20; top: calc(var(--nav-h) + 4px); display: flex; align-items: center; gap: 16px; margin-bottom: clamp(48px, 6vw, 80px); padding: 8px 8px 8px 20px; border-radius: var(--r-pill); background: rgba(255, 255, 255, 0.88); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); box-shadow: 0 0 0 1px rgba(29, 89, 187, 0.1), 0 14px 30px -22px rgba(29, 89, 187, 0.5); transition: top 420ms var(--ease-out); overflow: hidden; }
  :global(body:has(.nav.is-hidden)) .windex { top: 14px; }
  .windex__count { flex: none; display: flex; align-items: baseline; gap: 6px; font: 500 14px/1 var(--f-head); color: var(--c-muted); font-variant-numeric: tabular-nums; }
  .windex__count b { font: 700 20px/1 var(--f-head); color: var(--c-ink); }
  .windex ol { list-style: none; display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; flex: 1; justify-content: flex-end; }
  .windex ol::-webkit-scrollbar { display: none; }
  .windex a { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; min-height: 42px; padding: 0 16px; border-radius: var(--r-pill); text-decoration: none; font: 500 15px/1 var(--f-head); color: var(--c-text); transition: background 350ms var(--ease-out), color 350ms; }
  .windex a i { width: 9px; height: 9px; border-radius: 50%; background: var(--pc); transition: background 350ms; }
  .windex a:hover { background: var(--ps); }
  .windex a[aria-current="true"] { background: var(--pc); color: #fff; }
  .windex a[aria-current="true"] i { background: #fff; }
  .windex__bar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: rgba(29, 89, 187, 0.08); }
  .windex__bar span { display: block; height: 100%; background: var(--grad-word); transform-origin: 0 50%; transform: scaleX(0.02); }
  @media (max-width: 760px) {
    .windex { gap: 10px; padding-left: 14px; }
    .windex ol { justify-content: flex-start; }
    .windex a { padding: 0 12px; font-size: 14px; }
  }

  .rows { list-style: none; display: grid; gap: clamp(72px, 10vw, 140px); }
  .row { scroll-margin-top: calc(var(--nav-h) + 96px); }
  .row { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
  .row--flip { grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); }
  .row--flip .row__media { order: 2; }

  .row__media { position: relative; display: block; }
  .row__frame { position: relative; display: block; aspect-ratio: 16 / 10.5; overflow: hidden; border-radius: clamp(24px, 3vw, 40px); background: var(--ps); box-shadow: 0 50px 80px -60px rgba(11, 11, 15, 0.55); }
  .row__frame img { position: absolute; inset: -6% 0; width: 100%; height: 112%; object-fit: cover; transition: scale 900ms var(--ease-out); will-change: transform; }
  .row__media:hover .row__frame img { scale: 1.05; }
  /* glass circle + dot sit ABOVE the image and the colour, straddling the frame edge */
  .row__lens { position: absolute; z-index: 3; width: clamp(120px, 14vw, 210px); aspect-ratio: 1; right: calc(clamp(120px, 14vw, 210px) / -2.6); top: 12%; border-radius: 50%; background: linear-gradient(135deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.12)); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.7), 0 20px 40px -20px rgba(11, 11, 15, 0.35); transition: translate 900ms var(--ease-out); pointer-events: none; }
  .row__dot { position: absolute; z-index: 3; width: clamp(44px, 5vw, 70px); aspect-ratio: 1; right: clamp(20px, 3vw, 44px); bottom: -18px; border-radius: 50%; background: var(--pc); box-shadow: 0 0 0 6px #fff; pointer-events: none; }
  .row--flip .row__lens { right: auto; left: calc(clamp(120px, 14vw, 210px) / -2.6); }
  .row--flip .row__dot { right: auto; left: clamp(20px, 3vw, 44px); }
  .row__media:hover .row__lens { translate: 0 24px; }

  .row__num { display: flex; align-items: center; gap: 12px; font: 500 15px/1.3 var(--f-head); color: var(--c-muted); }
  .row__num span { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--pc); color: #fff; font: 700 14px/1 var(--f-head); }
  .row__title { margin: 18px 0 16px; font: 700 clamp(36px, 3.8vw, 56px)/1.02 var(--f-head); letter-spacing: -0.03em; }
  .row__title a { color: var(--pc); text-decoration: none; }
  .row__meta { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; }
  .row__meta li { padding: 7px 14px; border-radius: var(--r-pill); background: var(--ps); color: var(--pi); font: 500 13.5px/1 var(--f-head); }
  .row__text { margin-top: 18px; font: 400 17px/1.6 var(--f-head); color: var(--c-text); max-width: 28em; }
  .row__cta { display: inline-flex; align-items: center; gap: 14px; margin-top: 26px; text-decoration: none; font: 600 16px/1 var(--f-head); color: var(--c-ink); }
  .row__cta .arrow-btn { color: var(--pc); }
  .row__cta:hover .arrow-btn { background: var(--pc); color: #fff; transform: rotate(-45deg); }

  @media (max-width: 860px) {
    .row, .row--flip { grid-template-columns: 1fr; gap: 28px; }
    .row--flip .row__media { order: 0; }
    .row__lens { width: 110px; right: -24px; top: -26px; }
    .row--flip .row__lens { left: auto; right: -24px; }
  }
</style>
