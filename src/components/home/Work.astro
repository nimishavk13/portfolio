---
/* Selected work: each project is its own cover slide, stacked like a deck as you scroll. */
import { projects } from "../../data/projects";
---
<section class="work" id="work" aria-labelledby="work-title" data-section="work">
  <div class="wrap work__head">
    <h2 class="sec-title" id="work-title" data-reveal>Selected <span class="gw">work</span></h2>
    <p class="lead work__intro" data-reveal style="--d:120ms">Four individual projects, from a gardening kit for children to a trusted home for a 2,000-year-old craft.</p>
  </div>

  <ol class="deck wrap" role="list">
    {projects.map((p, i) => (
      <li class="card" data-card style={`--pc:${p.color};--ps:${p.soft};--i:${i}`}>
        <article class="card__in" data-card-in>
          <div class="card__panel">
            <span class="deco deco--pill" aria-hidden="true"></span>
            <span class="deco deco--pill2" aria-hidden="true"></span>
            <p class="card__kicker">Project {p.n} : {p.kicker}</p>
            <p class="card__meta">{p.meta.map((m, k) => <>{k > 0 && <b aria-hidden="true">|</b>}<span>{m}</span></>)}</p>
            <h3 class="card__title">{p.title}</h3>
            <p class="card__text">{p.intro}</p>
            <a class="card__cta" href={`/work/${p.slug}`}>
              <span>{p.type}</span>
              <span class="arrow-btn" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              <span class="sr-only">: read the {p.title} case study</span>
            </a>
          </div>
          <div class="card__media">
            <img src={p.image} alt={p.imageAlt} width="1400" height="900" loading="lazy" decoding="async" data-card-img />
            <span class="lens" aria-hidden="true"></span>
            <span class="dot" aria-hidden="true"></span>
          </div>
        </article>
      </li>
    ))}
  </ol>
</section>

<style>
  .work { padding-block: var(--section) calc(var(--section) * 0.6); }
  .work__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px 48px; margin-bottom: 48px; }
  .work__intro { max-width: 30em; color: var(--c-muted); }

  .deck { list-style: none; display: grid; gap: 28px; }
  .card { position: sticky; top: calc(var(--nav-h) + 12px + var(--i) * 14px); }
  .card__in {
    position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: min(74vh, 620px); border-radius: var(--r-xl); overflow: hidden; background: var(--pc);
    box-shadow: 0 -1px 0 rgba(255, 255, 255, 0.25) inset, 0 40px 80px -50px rgba(11, 11, 15, 0.55);
    transform-origin: 50% 0; will-change: transform;
  }
  .card__panel { position: relative; z-index: 2; display: flex; flex-direction: column; padding: clamp(28px, 4vw, 56px); color: #fff; }
  .card__kicker { font: 400 clamp(16px, 1.5vw, 21px)/1.3 var(--f-head); }
  .card__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; margin-top: 6px; font: 400 15px/1.3 var(--f-head); opacity: 0.88; }
  .card__meta b { font-weight: 700; }
  .card__title { margin-top: auto; padding-top: 32px; font: 700 clamp(40px, 5vw, 72px)/1 var(--f-head); letter-spacing: -0.03em; color: #fff; }
  .card__text { margin-top: 16px; max-width: 32em; font: 400 clamp(15px, 1.15vw, 17px)/1.6 var(--f-head); opacity: 0.92; }
  .card__cta { align-self: flex-start; display: inline-flex; align-items: center; gap: 14px; margin-top: 28px; padding: 6px 6px 6px 22px; border-radius: var(--r-pill); border: 1.5px solid rgba(255, 255, 255, 0.85); color: #fff; text-decoration: none; font: 600 16px/1 var(--f-head); transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast); }
  .card__cta .arrow-btn { width: 42px; height: 42px; background: #fff; color: var(--pc); border: 0; }
  .card__cta:hover { background: #fff; color: var(--pc); }
  .card__cta:hover .arrow-btn { transform: rotate(-45deg); background: var(--pc); color: #fff; }

  .card__media { position: relative; overflow: hidden; background: var(--ps); }
  .card__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(1.08); will-change: transform; }
  /* her cover-slide glass circle, straddling the split */
  .lens { position: absolute; left: -110px; top: 12%; width: 220px; height: 220px; border-radius: 50%; background: rgba(255, 255, 255, 0.16); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25); }
  .dot { position: absolute; left: -36px; bottom: 18%; width: 72px; height: 72px; border-radius: 50%; background: #fff; opacity: 0.9; }
  .card:nth-child(1) .dot { background: var(--lr-pop); opacity: 1; }
  .deco { position: absolute; border: 2px solid rgba(255, 255, 255, 0.85); border-radius: var(--r-pill); pointer-events: none; }
  .deco--pill { width: 120px; height: 48px; left: -70px; top: 28px; }
  .deco--pill2 { width: 120px; height: 48px; right: -70px; bottom: 28px; }
  .card__kicker, .card__meta { padding-left: 54px; }

  @media (max-width: 860px) {
    .card { position: relative; top: auto; }
    .card__in { grid-template-columns: 1fr; min-height: 0; }
    .card__media { order: -1; aspect-ratio: 16 / 10; }
    .card__title { padding-top: 20px; }
    .deco--pill2, .lens, .dot { display: none; }
  }
</style>
