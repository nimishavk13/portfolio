---
/*
  Opening: her cover slide, live. A frosted glass card ("UI/UX Design Portfolio 2026")
  floats over moving blue shapes and her white rings. Scrolling flies the camera
  through the card into her introduction ("I am Nimisha").
*/
const introWords = "an emerging UX designer who loves breaking down messy problems and turning them into seamless, intuitive experiences using creative thinking and AI tools to bring ideas to life.".split(" ");
const strong = new Set(["emerging", "UX", "designer", "seamless,", "intuitive", "experiences", "creative", "thinking", "AI", "tools"]);
---
<section class="hero" id="top" data-hero aria-label="Introduction">
  <div class="hero__stage" data-stage>
    <!-- 1 · cover -->
    <div class="cover" data-cover>
      <div class="blobs" data-blobs aria-hidden="true">
        <span class="blob blob--1" data-blob></span>
        <span class="blob blob--2" data-blob></span>
        <span class="blob blob--3" data-blob></span>
        <span class="blob blob--4" data-blob></span>
        <span class="blob blob--5" data-blob></span>
      </div>
      <svg class="ring ring--a" viewBox="0 0 200 200" aria-hidden="true" data-ring><circle cx="100" cy="100" r="99" pathLength="1" /></svg>
      <svg class="ring ring--b" viewBox="0 0 200 200" aria-hidden="true" data-ring><circle cx="100" cy="100" r="99" pathLength="1" /></svg>

      <div class="glass-wrap" data-glass-wrap>
        <div class="glass" data-glass>
          <span class="glass__sheen" aria-hidden="true"></span>
          <p class="glass__k" data-cover-k>UI/UX Design</p>
          <h1 class="glass__t" aria-label="UI/UX Design Portfolio 2026 by Nimisha Vk">
            <span class="glass__word" aria-hidden="true">{"Portfolio".split("").map((c) => <span class="ch"><span>{c}</span></span>)}</span>
            <span class="glass__year" data-cover-year aria-hidden="true">2026</span>
          </h1>
          <p class="glass__by" data-cover-by>Nimisha Vk <i aria-hidden="true">|</i> <a href="mailto:nimishavkattutharayil@gmail.com">nimishavkattutharayil@gmail.com</a></p>
        </div>
      </div>

      <a class="cue" href="#intro" data-cue aria-label="Scroll to the introduction">
        <span class="cue__mouse" aria-hidden="true"><i></i></span>
        <span>Scroll</span>
      </a>
    </div>

    <!-- 2 · introduction -->
    <div class="intro" id="intro" data-intro>
      <div class="intro__wash" aria-hidden="true"></div>
      <div class="intro__in">
        <div class="intro__copy">
          <p class="pill-label" data-intro-pill>Introduction</p>
          <h2 class="intro__title" data-intro-title><span class="iw"><span>I</span></span> <span class="iw"><span>am</span></span> <span class="iw"><span class="gw">Nimisha</span></span></h2>
          <p class="intro__lede" data-intro-lede>
            {introWords.map((w) => <><span class="iw"><span class={strong.has(w) ? "b" : undefined}>{w}</span></span>{" "}</>)}
          </p>
          <p class="intro__sign" data-intro-sign>Let’s build something impactful together.</p>
          <div class="intro__ctas" data-intro-ctas>
            <a class="btn" href="#work">See my work <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            <a class="btn btn--ghost" href="#about">About me</a>
          </div>
        </div>
        <figure class="intro__photo" data-intro-photo>
          <span class="intro__badge" data-intro-badge aria-hidden="true">UX</span>
          <img src="/img/v2/nimisha.webp" width="656" height="764" alt="Nimisha smiling, chin resting on her hand, in a café full of hanging plants" decoding="async" />
          <figcaption class="intro__loc" data-intro-loc><span>Based in</span>Pune, India</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; }
  .hero__stage { position: relative; overflow: hidden; }

  /* ---- cover ---- */
  .cover { position: relative; min-height: 100svh; display: grid; place-items: center; padding: calc(var(--nav-h) + 24px) var(--gx) 96px; overflow: hidden; background: linear-gradient(180deg, #f3f7ff 0%, #ffffff 100%); }
  .blobs { position: absolute; inset: 0; }
  .blob { position: absolute; border-radius: 50%; will-change: transform; }
  .blob--1 { width: 46vw; height: 46vw; left: -8vw; top: -6vw; background: radial-gradient(circle at 40% 40%, #2f6fe0 0%, #1d59bb 38%, rgba(29, 89, 187, 0) 70%); animation: drift1 16s ease-in-out infinite alternate; }
  .blob--2 { width: 30vw; height: 30vw; right: 4vw; top: 6vw; background: radial-gradient(circle at 50% 50%, #5b9bff 0%, #336ef9 35%, rgba(51, 110, 249, 0) 70%); animation: drift2 13s ease-in-out infinite alternate; }
  .blob--3 { width: 52vw; height: 52vw; right: -14vw; bottom: -24vw; background: radial-gradient(circle at 45% 40%, #76b9ff 0%, #3d7ff0 36%, rgba(61, 127, 240, 0) 70%); animation: drift3 18s ease-in-out infinite alternate; }
  .blob--4 { width: 18vw; height: 18vw; left: 14vw; bottom: 8vw; background: radial-gradient(circle, #1d59bb 0%, rgba(29, 89, 187, 0) 70%); animation: drift2 11s ease-in-out infinite alternate-reverse; }
  .blob--5 { width: 12vw; height: 12vw; left: 46vw; top: 4vw; background: radial-gradient(circle, #76b9ff 0%, rgba(118, 185, 255, 0) 70%); animation: drift1 9s ease-in-out infinite alternate-reverse; }
  @keyframes drift1 { to { translate: 4vw 3vw; scale: 1.08; } }
  @keyframes drift2 { to { translate: -3vw 4vw; scale: 0.92; } }
  @keyframes drift3 { to { translate: -5vw -3vw; scale: 1.06; } }
  .ring { position: absolute; fill: none; stroke: #fff; stroke-width: 1.1; filter: drop-shadow(0 0 1px rgba(29, 89, 187, 0.4)); }
  .ring circle { stroke-dasharray: 1; }
  .ring--a { width: min(46vw, 700px); right: -10vw; top: -20vw; }
  .ring--b { width: min(36vw, 520px); left: -14vw; bottom: -16vw; }

  .glass-wrap { position: relative; z-index: 2; width: min(920px, 100%); perspective: 1200px; }
  .glass {
    position: relative; overflow: hidden; padding: clamp(36px, 6vw, 84px) clamp(28px, 6vw, 80px) clamp(30px, 4vw, 54px);
    border-radius: clamp(24px, 3vw, 44px);
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.22));
    -webkit-backdrop-filter: blur(26px) saturate(1.35); backdrop-filter: blur(26px) saturate(1.35);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 40px 90px -40px rgba(13, 40, 85, 0.55);
    transform-style: preserve-3d; will-change: transform;
  }
  .glass__sheen { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(40% 60% at var(--sx, 30%) var(--sy, 20%), rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 70%); mix-blend-mode: soft-light; }
  .glass__k { font: 400 clamp(22px, 3.4vw, 50px)/1 var(--f-head); color: var(--c-ink); letter-spacing: -0.01em; }
  .glass__t { display: flex; align-items: flex-end; gap: 0.18em; margin: 0.08em 0 0.5em; font: 800 clamp(64px, 11vw, 168px)/0.95 var(--f-head); letter-spacing: -0.035em; color: var(--c-ink); }
  .glass__word { display: inline-flex; }
  .ch { display: inline-block; overflow: hidden; padding-bottom: 0.06em; margin-bottom: -0.06em; }
  .ch > span { display: inline-block; will-change: transform; }
  .glass__year { font-size: 0.4em; line-height: 1.1; padding-bottom: 0.12em; background: var(--grad-word); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .glass__by { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 12px; text-align: center; font: 400 clamp(15px, 1.45vw, 22px)/1.4 var(--f-head); color: var(--c-ink); }
  .glass__by i { font-style: normal; opacity: 0.5; }
  .glass__by a { text-decoration: none; }
  .glass__by a:hover { color: var(--c-blue); }

  .cue { position: absolute; left: 50%; bottom: 26px; translate: -50% 0; z-index: 3; display: grid; justify-items: center; gap: 8px; text-decoration: none; font: 600 12px/1 var(--f-body); letter-spacing: 0.16em; text-transform: uppercase; color: var(--c-ink); }
  .cue__mouse { width: 24px; height: 38px; border-radius: 14px; border: 2px solid currentColor; display: grid; justify-items: center; padding-top: 6px; }
  .cue__mouse i { width: 4px; height: 8px; border-radius: 2px; background: var(--c-blue); animation: wheel 1.6s var(--ease-out) infinite; }
  @keyframes wheel { 0% { opacity: 0; transform: translateY(-3px); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(10px); } }

  /* ---- intro ---- */
  .intro { position: relative; background: #fff; }
  .intro__wash { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(48% 60% at 0% 0%, rgba(51, 110, 249, 0.42), rgba(118, 185, 255, 0.16) 45%, rgba(255, 255, 255, 0) 75%); }
  .intro__in { position: relative; max-width: calc(var(--wrap) + 2 * var(--gx)); margin-inline: auto; padding: var(--section) var(--gx); display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .intro__title { font: 800 var(--fs-hero)/1 var(--f-head); letter-spacing: -0.035em; margin: 22px 0; }
  .intro__lede { font: 400 clamp(18px, 1.5vw, 21px)/1.6 var(--f-head); color: var(--c-text); max-width: 34em; }
  .intro__lede .b { color: var(--c-blue); font-weight: 600; }
  .iw { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.08em; margin-bottom: -0.08em; }
  .iw > span { display: inline-block; }
  .intro__sign { margin-top: 22px; font: 700 clamp(19px, 1.6vw, 23px)/1.4 var(--f-head); color: var(--c-ink); }
  .intro__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .intro__photo { position: relative; justify-self: end; width: min(100%, 420px); }
  .intro__photo img { width: 100%; aspect-ratio: 656 / 764; object-fit: cover; border-radius: var(--r-lg); box-shadow: 0 40px 80px -40px rgba(29, 89, 187, 0.6); }
  .intro__badge { position: absolute; top: -26px; right: -22px; z-index: 2; display: grid; place-items: center; width: 88px; height: 88px; border-radius: 22px; background: linear-gradient(140deg, #3f7cf6, #1a46a8); color: #fff; font: 700 30px/1 var(--f-head); rotate: -14deg; box-shadow: 0 18px 30px -12px rgba(29, 89, 187, 0.7), inset 0 2px 0 rgba(255, 255, 255, 0.25); }
  .intro__loc { position: absolute; left: -44px; bottom: 54px; z-index: 2; padding: 14px 20px; border-radius: 16px; background: #fff; font: 400 16px/1.4 var(--f-head); color: var(--c-ink); box-shadow: 0 20px 40px -20px rgba(11, 11, 15, 0.35); }
  .intro__loc span { display: block; color: var(--c-blue); font-size: 14px; }

  /* pinned version (wide screens, motion allowed) */
  :global(.hero-pinned) .hero { height: 280vh; }
  :global(.hero-pinned) .hero__stage { position: sticky; top: 0; height: 100svh; }
  :global(.hero-pinned) .cover { position: absolute; inset: 0; z-index: 2; min-height: 0; }
  :global(.hero-pinned) .intro { position: absolute; inset: 0; z-index: 1; display: grid; align-items: center; }
  :global(.hero-pinned) .intro__in { width: 100%; padding-block: calc(var(--nav-h) + 16px) 24px; }

  @media (max-width: 900px) {
    .intro__in { grid-template-columns: 1fr; padding-top: 72px; }
    .intro__photo { justify-self: center; width: min(86%, 360px); margin-top: 24px; }
    .intro__loc { left: -14px; bottom: 28px; }
    .intro__badge { right: -12px; width: 72px; height: 72px; font-size: 25px; }
    .blob--1 { width: 80vw; height: 80vw; } .blob--3 { width: 90vw; height: 90vw; } .blob--2 { width: 50vw; height: 50vw; }
  }
  @media (max-width: 560px) {
    .glass__t { flex-direction: column; align-items: flex-start; gap: 0; }
    .glass__year { font-size: 0.5em; }
    .glass__by { justify-content: flex-start; text-align: left; }
  }
</style>
