---
// Frame 2 (Figma 4:4700) – Introduction
---
<section class="intro frame" id="intro" aria-labelledby="intro-title">
  <span class="blur-glow intro__glow" aria-hidden="true"></span>

  <p class="intro__label abs" style="--x:63;--y:240;--w:299" data-reveal="from-left">Introduction</p>

  <h2 class="intro__title abs section-title" id="intro-title" style="--x:82;--y:336" data-reveal="rise" >
    I am <span class="grad-word intro__name">Nimisha</span>
  </h2>

  <p class="intro__text abs" style="--x:82;--y:536;--w:949" data-reveal="rise">
    an <b>emerging UX designer</b> who loves breaking down messy problems and turning them into{" "}
    <b>seamless, intuitive experiences</b> using <b>creative thinking</b> and <b>AI tools</b> to bring ideas to life.
  </p>

  <p class="intro__cta abs" style="--x:82;--y:768;--w:1056" data-reveal="rise">Let’s build something impactful together.</p>

  <div class="intro__media abs" style="--x:1192;--y:153;--w:665;--h:773" data-reveal="from-right">
    <span class="intro__shadow" aria-hidden="true"></span>
    <img src="/img/home/nimisha-photo.webp" width="665" height="773"
      alt="Nimisha smiling, resting her chin on her hand in a café full of hanging plants" />
  </div>

  <span class="intro__badge abs" style="--x:1780;--y:128;--w:100;--h:100;--rot:-21deg" data-reveal="pop" aria-hidden="true">UX</span>

  <p class="intro__based abs" style="--x:1128;--y:793;--w:175;--h:101" data-reveal="rise">
    <span>Based in</span> Pune, India
  </p>
</section>

<style>
  .intro { overflow: visible; }
  .intro__glow {
    /* Figma: Ellipse 44, #1d59bb, layer blur 457 */
    left: calc(-286 * var(--px)); top: calc(-285 * var(--px));
    width: calc(595 * var(--px)); height: calc(595 * var(--px));
    background: #1d59bb; filter: blur(calc(220 * var(--px)));
  }
  .intro__label {
    height: calc(76 * var(--px));
    display: grid; place-items: center;
    border: calc(3 * var(--px)) solid var(--blue); border-radius: calc(40 * var(--px));
    color: var(--blue); font-weight: 700; font-size: calc(35 * var(--px));
  }
  .intro__title { color: #000; }
  .intro__name {
    background: linear-gradient(90deg, #1d59bb 39%, #76b9ff 100%);
    -webkit-background-clip: text; background-clip: text;
  }
  .intro__text { font-size: calc(35 * var(--px)); line-height: 1.5; --d: 120ms; }
  .intro__text b { color: var(--blue); font-weight: 700; }
  .intro__cta { font-size: calc(48 * var(--px)); font-weight: 700; line-height: 1.5; --d: 220ms; }

  .intro__media { --d: 100ms; }
  .intro__media img {
    position: relative; width: 100%; height: 100%; object-fit: cover;
    border-radius: calc(40 * var(--px));
    /* Figma: drop shadow 22,26 blur 51.8 #1d59bb @25% */
    box-shadow: calc(22 * var(--px)) calc(26 * var(--px)) calc(52 * var(--px)) rgba(29, 89, 187, 0.25);
  }
  .intro__shadow {
    /* Figma "image 2": blurred blue copy behind the photo (93,109 offset, 69%) */
    position: absolute;
    left: calc(93 * var(--px)); top: calc(109 * var(--px));
    width: calc(575 * var(--px)); height: calc(668 * var(--px));
    border-radius: calc(40 * var(--px));
    background: #1d59bb; opacity: 0.69;
    filter: blur(calc(120 * var(--px)));
  }

  .intro__badge {
    display: grid; place-items: center;
    border-radius: calc(22 * var(--px));
    background: linear-gradient(135deg, #003387 27%, #4682ce 76%, #73b8ff 100%);
    box-shadow: calc(3 * var(--px)) calc(-2 * var(--px)) calc(9 * var(--px)) rgba(0,0,0,0.25);
    color: #fff; font-weight: 700; font-size: calc(48 * var(--px));
    transform: rotate(-21deg);
    --d: 450ms;
    transition-duration: 1100ms;
  }
  .intro__based {
    padding: calc(20 * var(--px)) calc(27 * var(--px));
    border-radius: calc(15 * var(--px));
    background: rgba(255,255,255,0.92);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: calc(-2 * var(--px)) calc(2 * var(--px)) calc(9 * var(--px)) rgba(0,0,0,0.25);
    font-size: calc(20 * var(--px)); line-height: 1.5; color: #000;
    --d: 600ms;
  }
  .intro__based span { display: block; color: var(--blue); }

  @media (max-width: 1099px) {
    .intro { display: flex; flex-direction: column; gap: 22px; }
    .intro__glow { left: -45vw; top: -40vw; width: 90vw; height: 90vw; filter: blur(80px); }
    .intro__label { align-self: flex-start; height: auto; padding: 8px 20px; border-width: 2px; border-radius: 40px; font-size: 16px; }
    .intro__title { font-size: clamp(48px, 13vw, 80px); }
    .intro__text { font-size: clamp(18px, 4.6vw, 24px); }
    .intro__cta { font-size: clamp(22px, 5.6vw, 30px); line-height: 1.3; }
    .intro__media { order: -1; margin-top: 8px; width: min(100%, 420px) !important; aspect-ratio: 665 / 773; align-self: center; }
    .intro__media img { border-radius: 28px; box-shadow: 14px 16px 34px rgba(29, 89, 187, 0.25); }
    .intro__shadow { left: 12%; top: 12%; width: 86%; height: 86%; border-radius: 28px; filter: blur(50px); }
    .intro__badge {
      position: absolute !important; width: 64px !important; height: 64px !important;
      right: max(var(--gutter), calc(50% - 210px - 16px)); top: 92px; left: auto !important;
      border-radius: 16px; font-size: 30px;
    }
    .intro__based {
      position: absolute !important; left: max(var(--gutter), calc(50% - 210px - 12px)) !important;
      top: calc(96px + min(100vw - 32px, 420px) * 773 / 665 - 70px) !important;
      padding: 10px 16px; border-radius: 12px; font-size: 14px;
    }
    .intro__media, .intro__badge, .intro__based { order: -1; }
  }
</style>
