---
<section class="process frame" id="process" aria-labelledby="process-title">
  <svg class="abs" style="--x:1588;--y:144;--w:332;--h:380" viewBox="0 0 332 380" aria-hidden="true"><defs><linearGradient id="pr-r" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#BFD7FC"/><stop offset="1" stop-color="#90B2E9"/></linearGradient></defs><path d="M331.679 0C204.138 40.2154 66.2567 132.136 8.80611 189.587C-14.1741 224.057 8.80611 252.783 66.2567 264.273C181.158 281.508 273.079 327.469 331.679 379.174V0Z" fill="url(#pr-r)"/></svg>
  <svg class="abs" style="--x:0;--y:396;--w:184;--h:391" viewBox="0 0 184 391" aria-hidden="true"><defs><linearGradient id="pr-l" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#A8C7F4"/><stop offset="1" stop-color="#C2D7FF"/></linearGradient></defs><path d="M0 0C57.4506 40.2154 149.372 45.9605 183.842 86.1759L160.862 247.038C114.901 315.978 57.4506 350.449 0 390.664V0Z" fill="url(#pr-l)"/></svg>
  <svg class="abs process__deco" style="--x:1201;--y:0;--w:484;--h:250" viewBox="0 0 484 250" aria-hidden="true"><path d="M0.45459 0C98.1207 126.391 270.473 241.293 483.04 249.336" stroke="#9DBBF9" stroke-width="1.15" fill="none"/></svg>
  <svg class="abs process__deco" style="--x:0;--y:892;--w:438;--h:188" viewBox="0 0 438 188" aria-hidden="true"><path d="M437.331 249.91C339.664 123.518 167.313 8.61703 -45.2547 0.573941" stroke="#9DBBF9" stroke-width="1.15" fill="none"/></svg>

  <h2 class="abs process__title" id="process-title" style="--x:60;--y:60" data-reveal="rise">
    Design <span class="process__grad">Process</span>
  </h2>

  <ol class="process__stages" role="list">
    {stages.map((s, i) => (
      <li class="stage abs" style={`--x:${s.x};--y:${s.y};--w:${s.w};--h:${s.h};--ny:${s.ny};--d:${i * 140}ms`} data-reveal="rise">
        <span class="stage__icon" style={`--ix:${s.ix};--iy:${s.iy};--iw:${s.iw}`} set:html={s.icon} aria-hidden="true"></span>
        <span class="stage__num">{s.n}<i aria-hidden="true"></i></span>
        <h3 class="stage__title">{s.t}</h3>
        <p class="stage__desc">{s.d}</p>
      </li>
    ))}
  </ol>

  <div class="process__links" aria-hidden="true" data-connectors>
    {connectors.map((c, i) => (
      <>
        <svg class="abs connector" style={`--x:${c.x};--y:${c.y};--w:${c.w};--h:${c.h};--d:${300 + i * 140}ms`} viewBox={`0 0 ${c.w} ${c.h}`}>
          <path d={c.d} pathLength="1" stroke="#2C5CA3" stroke-width="1.72" stroke-linecap="round" fill="none" />
        </svg>
        <span class="abs dot" style={`--x:${c.a[0]};--y:${c.a[1]}`}></span>
        <span class="abs dot" style={`--x:${c.b[0]};--y:${c.b[1]}`}></span>
      </>
    ))}
  </div>

  <svg class="abs process__spark" style="--x:1082;--y:321;--w:59;--h:52" viewBox="0 0 59 52" aria-hidden="true"><path d="M7.18174 2.58594L2.58569 24.4172M37.0561 12.9271L20.9699 32.4603M55.4403 39.3543L32.46 48.5464" stroke="#376AFA" stroke-width="5.17" stroke-linecap="round" fill="none"/></svg>
</section>

<style>
  .process { overflow: visible; }
  .process__title {
    font-family: var(--font-figtree); font-weight: 800;
    font-size: calc(123 * var(--px)); line-height: calc(98 * var(--px)); letter-spacing: -0.025em;
    white-space: nowrap;
  }
  .process__grad {
    background: linear-gradient(90deg, #1d59bb 88%, #76b9ff 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .process__stages { margin: 0; padding: 0; list-style: none; }
  .process__links { position: absolute; inset: 0; max-width: 1920px; pointer-events: none; }
  .stage {
    border-radius: calc(70 * var(--px));
    background: linear-gradient(180deg, #ddeafe 0%, #dbe8fd 100%);
    font-family: var(--font-figtree);
    transition: transform var(--dur) var(--ease-out), opacity var(--dur) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .stage:hover { box-shadow: 0 calc(18 * var(--px)) calc(40 * var(--px)) rgba(29, 89, 187, 0.14); }
  .stage__icon {
    position: absolute; left: calc(var(--ix) * var(--px)); top: calc(var(--iy) * var(--px));
    width: calc(var(--iw) * var(--px));
  }
  .stage__icon :global(svg) { width: 100%; height: auto; overflow: visible; transition: transform var(--dur-fast) var(--ease-out); }
  .stage:hover .stage__icon :global(svg) { transform: translateY(calc(-4 * var(--px))) rotate(-3deg); }
  .stage__num {
    position: absolute; left: calc(53 * var(--px)); top: calc(var(--ny) * var(--px));
    display: flex; align-items: center; gap: calc(10 * var(--px));
    color: var(--process-num); font-weight: 700; font-size: calc(33 * var(--px)); line-height: calc(36 * var(--px));
  }
  .stage__num i { width: calc(26 * var(--px)); height: calc(3 * var(--px)); background: var(--process-num); }
  .stage__title {
    position: absolute; left: calc(53 * var(--px)); top: calc((var(--ny) + 41) * var(--px));
    font-weight: 700; font-size: calc(48 * var(--px)); line-height: calc(52 * var(--px)); letter-spacing: -0.01em;
  }
  .stage__desc {
    position: absolute; left: calc(53 * var(--px)); top: calc((var(--ny) + 103) * var(--px));
    width: calc(var(--w) * var(--px) - 106 * var(--px));
    color: var(--ink-muted); font-size: calc(31.5 * var(--px)); line-height: calc(36 * var(--px));
  }
  .stage:nth-child(1) .stage__desc { width: calc(185 * var(--px)); }
  .stage:nth-child(4) .stage__desc { width: calc(170 * var(--px)); }
  .stage:nth-child(5) .stage__desc { width: calc(190 * var(--px)); }

  .connector path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 900ms var(--ease-out) var(--d); }
  .connector { overflow: visible; }
  .dot {
    width: calc(13 * var(--px)); height: calc(13 * var(--px)); border-radius: 50%; background: #2c5ca3;
    transform: scale(0); transition: transform 400ms var(--ease-out) 500ms;
  }
  .process__links.is-drawn .connector path { stroke-dashoffset: 0; }
  .process__links.is-drawn .dot { transform: scale(1); }
  :global(html:not(.js)) .connector path { stroke-dashoffset: 0; }
  :global(html:not(.js)) .dot { transform: none; }

  @media (max-width: 1099px) {
    .process__title { font-size: clamp(44px, 12vw, 72px); line-height: 1.05; white-space: normal; margin-bottom: 30px; }
    .process > svg.abs:not(.process__spark) { position: absolute !important; opacity: 0.6; }
    .process > svg.abs:nth-of-type(1) { right: 0; left: auto; top: 18%; width: 30vw !important; }
    .process > svg.abs:nth-of-type(2) { left: 0; top: 55%; width: 22vw !important; }
    .process__deco { display: none; }
    .process__spark, .process__links { display: none; }
    .process__stages { position: relative; display: grid; gap: 14px; }
    .process__stages::before {
      content: ""; position: absolute; left: 50px; top: 30px; bottom: 30px; width: 2px;
      background: repeating-linear-gradient(#2c5ca3 0 6px, transparent 6px 12px);
    }
    .stage {
      position: relative; border-radius: 32px; padding: 20px 22px 22px 112px; min-height: 120px;
      display: flex; flex-direction: column; justify-content: center;
    }
    .stage__icon { left: 12px; top: 50%; width: 80px; transform: translateY(-50%); }
    .stage__num, .stage__title, .stage__desc { position: static; width: auto !important; }
    .stage__num { font-size: 16px; line-height: 1.3; gap: 8px; }
    .stage__num i { width: 18px; height: 2px; }
    .stage__title { font-size: 24px; line-height: 1.25; margin-top: 2px; }
    .stage__desc { font-size: 16px; line-height: 1.4; margin-top: 2px; }
  }
</style>

<script>
  // draw the connectors once the stages have risen in
  const links = document.querySelector("[data-connectors]");
  if (links) {
    if (!("IntersectionObserver" in window)) links.classList.add("is-drawn");
    else {
      const io = new IntersectionObserver(([e]) => {
        if (e.isIntersecting) { links.classList.add("is-drawn"); io.disconnect(); }
      }, { threshold: 0.3 });
      io.observe(links.closest("section")!);
    }
  }
</script>
