  { x: 761, y: 538, w: 50, h: 33, d: "M0.861816 31.8852C12.3519 14.65 30.7361 3.15984 49.1203 0.861816", a: [752, 565], b: [803, 532] },
  { x: 1113, y: 538, w: 54, h: 39, d: "M0.862061 0.861816C24.9913 6.60688 39.9285 20.395 52.5676 37.6302", a: [1107, 532], b: [1156, 568] },
  { x: 1462, y: 538, w: 54, h: 33, d: "M0.861816 31.8852C12.3519 16.948 30.7361 3.15984 52.5674 0.861816", a: [1454, 562], b: [1507, 532] },
