---
// Navigation between case studies, built from the "Selected work" card styles.
import type { Project } from "../data/projects";
interface Props { project: Project }
const { project } = Astro.props;
---
<nav class="next" aria-label="More work">
  <a class="next__all" href="/#work"><span aria-hidden="true">←</span> All work</a>
  <a class="next__card" href={`/work/${project.slug}`}>
    <span class="next__label">Next project</span>
    <span class="next__row">
      <span class="next__img"><img src={project.cardImage} alt="" loading="lazy" /></span>
      <span class="next__text">
        <span class="next__title">{project.title}</span>
        <span class="next__sum">{project.summary}</span>
      </span>
      <span class="next__arrow" aria-hidden="true">
        <svg viewBox="0 0 82 82"><rect x="1" y="1" width="80" height="80" rx="40" class="r"/><path d="M24.12 41H57.88M44.55 54.33L57.88 41L44.55 27.68" class="c"/></svg>
      </span>
    </span>
  </a>
</nav>

<style>
  .next {
    width: var(--container); margin: 0 auto; padding: calc(80 * var(--px)) 0 calc(40 * var(--px));
    display: grid; gap: 28px; font-family: var(--font-figtree);
    border-top: 2px solid #cbd6f3;
  }
  .next__all { justify-self: start; display: inline-flex; gap: 8px; align-items: center; min-height: 44px; color: var(--blue); font-weight: 700; text-decoration: none; font-size: 18px; }
  .next__all span { transition: transform var(--dur-fast) var(--ease-out); }
  .next__all:hover span { transform: translateX(-4px); }
  .next__card { text-decoration: none; color: inherit; display: block; border-radius: 30px; }
  .next__label { display: block; color: var(--ink-soft); font-size: calc(35 * var(--px)); margin-bottom: 14px; }
  .next__row { display: flex; align-items: center; gap: calc(40 * var(--px)); }
  .next__img { width: calc(420 * var(--px)); aspect-ratio: 582 / 344; border-radius: calc(40 * var(--px)); overflow: hidden; flex: none; background: #eef3fd; }
  .next__img img { width: 100%; height: 100%; object-fit: cover; transition: transform 700ms var(--ease-out); }
  .next__text { flex: 1; display: grid; gap: 6px; }
  .next__title { font-weight: 800; font-size: calc(85.5 * var(--px)); line-height: 1.1; letter-spacing: -0.015em; color: #000; }
  .next__sum { color: var(--ink-soft); font-size: calc(35 * var(--px)); }
  .next__arrow { width: calc(82 * var(--px)); flex: none; }
  .next__arrow svg { width: 100%; overflow: visible; }
  .r { fill: #fff; stroke: var(--blue-ui); stroke-width: 2; transition: fill var(--dur-fast) var(--ease-out); }
  .c { fill: none; stroke: var(--blue-arrow); stroke-width: 3.9; stroke-linecap: round; stroke-linejoin: round; transition: transform var(--dur-fast) var(--ease-out), stroke var(--dur-fast); }
  .next__card:hover .next__img img, .next__card:focus-visible .next__img img { transform: scale(1.045); }
  .next__card:hover .r, .next__card:focus-visible .r { fill: var(--blue-ui); }
  .next__card:hover .c, .next__card:focus-visible .c { stroke: #fff; transform: translateX(4px); }

  @media (max-width: 1179px) {
    .next { width: auto; padding: 48px var(--gutter) 24px; }
    .next__label { font-size: 16px; }
    .next__row { gap: 16px; }
    .next__img { width: 38%; border-radius: 18px; }
    .next__title { font-size: clamp(24px, 6.4vw, 40px); }
    .next__sum { font-size: 15px; }
    .next__arrow { width: 48px; }
  }
</style>
