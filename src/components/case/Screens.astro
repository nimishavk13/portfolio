---
import { md } from "../../lib/md";
import type { Img } from "../../data/case-types";
interface Props { device: "phone" | "tablet"; intro?: string; items: (Img & { title: string; desc?: string })[]; cvd?: boolean }
const { device, intro, items, cvd } = Astro.props;
---
<div class={`scr scr--${device}`} data-scr>
  {intro && <p class="b-lead" data-reveal set:html={md(intro)} />}
  {cvd && (
    <div class="cvd" data-reveal>
      <div>
        <p class="cvd__t">See it the way Rohan might</p>
        <p class="cvd__d">Applies a simulated red-green colour deficiency (deuteranopia) to the screens below. Information in Mentora never relies on colour alone.</p>
      </div>
      <button class="cvd__btn" type="button" role="switch" aria-checked="false" data-cvd><span class="cvd__knob" aria-hidden="true"></span><span class="sr-only">Simulate colour vision deficiency</span></button>
      <svg width="0" height="0" aria-hidden="true" style="position:absolute"><filter id="deut"><feColorMatrix type="matrix" values="0.625 0.375 0 0 0  0.7 0.3 0 0 0  0 0.3 0.7 0 0  0 0 0 1 0"/></filter></svg>
    </div>
  )}
  <ul class="scr__row" role="list" data-scr-row>
    {items.map((s, i) => (
      <li class="scr__item" data-scr-item style={`--i:${i}`}>
        <div class="scr__frame"><img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" /></div>
        <h3><small>{String(i + 1).padStart(2, "0")}</small>{s.title}</h3>
        {s.desc && <p>{s.desc}</p>}
      </li>
    ))}
  </ul>
</div>
