<style>
  .foot { border-top: 1px solid var(--c-line); padding-block: 28px; font-size: var(--fs-small); color: var(--c-muted); }
  .foot__in { display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: space-between; align-items: center; }
  .foot ul { display: flex; flex-wrap: wrap; gap: 8px 24px; list-style: none; }
  .foot a { text-decoration: none; color: var(--c-text); }
  .foot a:hover { color: var(--c-blue); text-decoration: underline; text-underline-offset: 4px; }
</style>
