---
/*
  Frame 1 (Figma 4:4799) – "UI/UX Design / Portfolio 2026"
  Every element below exists in the Figma frame; positions, sizes, colours and
  type are copied from it (design px on a 1920×1080 canvas). The scattered start
  state and the paths each element travels are defined in src/scripts/hero.ts.
*/
const orbs = [
  { id: "o48", x: 1238, y: 542, d: 727 },
  { id: "o49", x: 1628, y: 275, d: 223 },
  { id: "o50", x: 21, y: 85, d: 466 },
  { id: "o51", x: 405, y: 598, d: 194 },
  { id: "o52", x: 83, y: 619, d: 138 },
];
const rings = [
  { id: "r53", x: 1394, y: -93, d: 644 },
  { id: "r54", x: -168, y: 667, d: 644 },
];
---
<section class="hero" id="top" aria-labelledby="hero-title" data-hero data-nav-dark>
  <div class="hero__sticky">
    <div class="hero__bg" aria-hidden="true">
      {orbs.map((o) => (
        <span class="orb" data-el={o.id}
          style={`--x:${o.x};--y:${o.y};--d:${o.d}`}></span>
      ))}
      {rings.map((r) => (
        <span class="ring" data-el={r.id}
          style={`--x:${r.x};--y:${r.y};--d:${r.d}`}></span>
      ))}
    </div>

    <div class="hero__fg" data-fg>
      <div class="hero__tilt" data-tilt>
        <div class="hero__card" data-el="card" aria-hidden="true"></div>
        <h1 class="hero__title" id="hero-title">
          <span class="hero__kicker" data-el="uiux">UI/UX Design</span>{" "}
          <span class="hero__main">
            <span class="hero__word" data-el="portfolio">Portfolio</span>{" "}
            <span class="hero__year" data-el="year">2026</span>
          </span>
        </h1>
        <p class="hero__name" data-el="name">
          Nimisha Vk <span aria-hidden="true">|</span>{" "}
          <a href="mailto:nimishavkattutharayil@gmail.com">nimishavkattutharayil@gmail.com</a>
        </p>
      </div>
    </div>

    <div class="hero__hint" data-hint aria-hidden="true">
      <span>Scroll</span><i></i>
    </div>
  </div>
</section>

<style>
  .hero {
    /* pinned for the assembly; the extra height is the scroll "track" */
    position: relative;
    height: 280svh;
    background: linear-gradient(168deg, #10182b 0%, #10182b 18%, #1d59bb 84%);
  }
  .hero__sticky {
    position: sticky; top: 0;
    height: 100svh; overflow: hidden;
    /* Figma frame fill: linear #10182b → #1d59bb */
    background: linear-gradient(168deg, #10182b 0%, #10182b 18%, #1d59bb 84%);
    /* design-px units: background covers, foreground fits */
    --ub: max(calc(100vw / 1920), calc(100svh / 1080));
    --uf: min(calc(var(--container) / 1920), calc((100svh - var(--nav-h)) / 1080));
  }

  /* ---------- background: orbs + rings on a covering 1920×1080 stage ---------- */
  .hero__bg {
    position: absolute; left: 50%; top: 50%;
    width: calc(1920 * var(--ub)); height: calc(1080 * var(--ub));
    transform: translate(-50%, -50%);
  }
  .orb, .ring {
    position: absolute;
    left: calc(var(--x) * var(--ub)); top: calc(var(--y) * var(--ub));
    width: calc(var(--d) * var(--ub)); height: calc(var(--d) * var(--ub));
    border-radius: 50%;
    will-change: transform;
  }
  .orb {
    /* Figma: linear #c5d0ea 0% → #1d59bb 32% → #030f2b 89%, layer blur 67 */
    background: linear-gradient(140deg, #c5d0ea 0%, #1d59bb 32%, #030f2b 89%);
    filter: blur(calc(34 * var(--ub)));
  }
  .ring { border: calc(5 * var(--ub)) solid #fff; }

  /* ---------- foreground: glass card + type, fitted to the viewport ---------- */
  .hero__fg {
    position: absolute; left: 50%; top: 50%;
    width: calc(1353 * var(--uf)); height: calc(742 * var(--uf));
    transform: translate(-50%, -50%);
    perspective: 1600px;
  }
  .hero__tilt {
    position: absolute; inset: 0;
    will-change: transform;
  }
  .hero__card {
    position: absolute; inset: 0;
    border-radius: calc(50 * var(--uf));
    /* Figma: #ffffff @10% with Glass effect */
    background:
      linear-gradient(180deg, rgba(16,24,43,0.16) 0%, rgba(16,24,43,0.04) 50%, rgba(255,255,255,0.08) 100%);
    -webkit-backdrop-filter: blur(20px) saturate(1.1);
    backdrop-filter: blur(20px) saturate(1.1);
    box-shadow:
      inset 0 0 0 1px rgba(255,255,255,0.28),
      inset 1px 1px 0 rgba(255,255,255,0.35),
      inset 0 0 calc(60 * var(--uf)) rgba(255,255,255,0.05);
    }
  .hero__title, .hero__name { color: #fff; font-family: var(--font-poppins); }
  .hero__title { font-weight: inherit; }
  .hero__kicker, .hero__main, .hero__name { position: absolute; will-change: transform; }
  .hero__kicker {
    /* 355,284 in frame → 71,115 in card */
    left: calc(71 * var(--uf)); top: calc(115 * var(--uf));
    font-size: calc(80 * var(--uf)); font-weight: 400; line-height: 1.04; white-space: nowrap;
  }
  .hero__main {
    left: calc(60 * var(--uf)); top: calc(224 * var(--uf));
    font-weight: 700; line-height: 1.04; white-space: nowrap;
    display: flex; align-items: baseline;
  }
  .hero__word, .hero__year { display: inline-block; will-change: transform; }
  .hero__word { font-size: calc(200 * var(--uf)); letter-spacing: -0.005em; }
  .hero__year { font-size: calc(100 * var(--uf)); margin-left: calc(52 * var(--uf)); }
  .hero__name {
    left: calc(188 * var(--uf)); top: calc(640 * var(--uf)); width: calc(975 * var(--uf));
    text-align: center; font-size: calc(40 * var(--uf)); line-height: 1.04;
  }
  .hero__name a { color: inherit; text-decoration: none; }
  .hero__name a:hover { text-decoration: underline; text-underline-offset: 0.2em; }

  .hero__hint {
    position: absolute; left: 50%; bottom: 28px; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    color: rgba(255,255,255,0.75); font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase;
    transition: opacity 400ms var(--ease-out);
  }
  .hero__hint i {
    width: 1px; height: 36px; background: linear-gradient(#fff, transparent);
    transform-origin: top; animation: hint 1.8s var(--ease-out) infinite;
  }
  @keyframes hint { 0% { transform: scaleY(0); } 60% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }

  /* ---------- portrait / phones: same card, type re-flowed to stay legible ---------- */
  @media (max-aspect-ratio: 1/1), (max-width: 760px) {
    /* keep the orbs and rings around the card instead of off-screen */
    .hero__sticky { --ub: calc(100vw / 820); }
    .hero__fg {
      width: min(88vw, 620px); height: auto; min-height: 0;
      --uf: calc(min(88vw, 620px) / 1353);
    }
    .hero__tilt { position: relative; padding: 40px 26px 34px; }
    .hero__card { border-radius: 28px; }
    .hero__title { position: relative; display: flex; flex-direction: column; gap: 6px; }
    .hero__kicker, .hero__main, .hero__name { position: relative; left: auto; top: auto; width: auto; }
    .hero__kicker { font-size: clamp(22px, 6.4vw, 34px); }
    .hero__word { font-size: clamp(40px, 12vw, 84px); }
    .hero__year { font-size: clamp(20px, 6vw, 42px); margin-left: 8px; }
    .hero__name { margin-top: 34px; font-size: clamp(12px, 3.4vw, 16px); white-space: normal; line-height: 1.5; }
    .hero__name span { display: none; }
    .hero__name a { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero { height: 100svh; }
    .hero__hint { display: none; }
  }
</style>

<script>
  import { initHero } from "../scripts/hero";
  initHero();
</script>
