---
// Frame 3 (Figma 4:4684) – About me: Education / Skills / Tools
const soft = [["Problem Solving",152],["Critical Thinking",152],["Communication",152],["Collaboration",152],["Empathy",95],["Attention to Detail",169],["Conflict Management",218],["Adaptability",166]] as const;
const hard = [["User Research",152],["Usability Testing",152],["Journey Mapping",152],["Personas",112],["Information Architecture",218],["Wireframing",150],["Interaction Design",183],["Prototyping",152],["Card Sorting",139]] as const;
const tools = [
  { name: "Figma", img: "tool-figma" },
  { name: "Illustrator", img: "tool-illustrator" },
  { name: "Photoshop", img: "tool-photoshop", round: true },
  { name: "Premiere Pro", img: "tool-premiere" },
  { name: "In Design", img: "tool-indesign" },
  { name: "Miro", img: "tool-miro" },
];
---
<section class="about frame" id="about" aria-labelledby="about-title">
  <span class="blur-glow about__glow" aria-hidden="true"></span>

  <h2 class="abs section-title" id="about-title" style="--x:50;--y:50" data-reveal="rise">
    About <span class="about__me">me</span>
  </h2>

  <!-- Education -->
  <article class="card card--edu abs" style="--x:50;--y:240;--w:692;--h:754" data-reveal="rise">
    <span class="card--edu__glow" aria-hidden="true"></span>
    <span class="card--edu__band" aria-hidden="true"></span>
    <h3 class="card__title">Education</h3>
    <div class="edu__block edu__block--1">
      <p>Undergraduate (Pursuing)</p>
      <p class="edu__degree"><b>Bachelor of Design - User Experience Design</b></p>
      <p>Symbiosis Institute of Design, Pune<br />2023 - 2027</p>
    </div>
    <hr class="edu__rule" />
    <div class="edu__block edu__block--2">
      <p>Schooling</p>
      <p><b>Higher secondary - Science (CBSE)</b><br />Blossom Public School, Tathawade<br />2022 - 2023</p>
    </div>
  </article>

  <!-- Skills -->
  <article class="card card--skills abs" style="--x:774;--y:240;--w:572;--h:754;--d:120ms" data-reveal="rise">
    <h3 class="card__title">Skills</h3>
    <div class="skills__group skills__group--soft">
      <h4><i aria-hidden="true"></i>Soft skills</h4>
      <ul role="list">{soft.map(([s, w]) => <li style={`--cw:${w}`}>{s}</li>)}</ul>
    </div>
    <hr class="skills__rule" />
    <div class="skills__group skills__group--hard">
      <h4><i aria-hidden="true"></i>Hard skills</h4>
      <ul role="list">{hard.map(([s, w]) => <li style={`--cw:${w}`}>{s}</li>)}</ul>
    </div>
  </article>
  <svg class="about__cursor abs" style="--x:1228;--y:979;--w:67;--h:67" viewBox="0 0 67 67" aria-hidden="true" data-reveal="from-left">
    <path d="M0.176994 5.16403C-0.761767 2.05866 2.19225 -0.813769 5.27011 0.211584L63.6029 19.6445C67.2643 20.8642 67.2459 26.0497 63.5759 27.2433L35.9908 36.2149C34.7723 36.6113 33.8173 37.5674 33.4226 38.7865L25.4217 63.4931C24.2144 67.2214 18.9215 67.1695 17.7874 63.4182L0.176994 5.16403Z" fill="#1D59BB"/>
  </svg>

  <!-- Tools -->
  <article class="card card--tools abs" style="--x:1376;--y:244;--w:494;--h:754;--d:240ms" data-reveal="rise">
    <span class="tools__glow tools__glow--a" aria-hidden="true"></span>
    <span class="tools__glow tools__glow--b" aria-hidden="true"></span>
    <h3 class="card__title">Tools</h3>
    <ul class="tools" role="list">
      {tools.map((t) => (
        <li class="tool">
          <img src={`/img/home/${t.img}.webp`} width="90" height="90" alt="" class={t.round ? "tool__round" : ""} loading="lazy" />
          <span>{t.name}</span>
        </li>
      ))}
    </ul>
  </article>
</section>

<style>
  .about { overflow: visible; }
  .about__glow {
    left: calc(1590 * var(--px)); top: calc(-348 * var(--px));
    width: calc(595 * var(--px)); height: calc(595 * var(--px));
    background: #1d59bb; filter: blur(calc(220 * var(--px)));
  }
  .about__me {
    background: linear-gradient(90deg, #1d59bb 72%, #76b9ff 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  .card {
    border-radius: calc(40 * var(--px));
    overflow: hidden;
    padding: calc(50 * var(--px));
    transition: transform var(--dur) var(--ease-out), opacity var(--dur) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .card__title { position: relative; font-size: calc(55 * var(--px)); font-weight: 700; line-height: 1.5; }

  /* Education */
  .card--edu { background: linear-gradient(180deg, #1d59bb 2%, #0d2855 78%); color: #fff; }
  .card--edu__glow {
    position: absolute; left: calc(465 * var(--px)); top: calc(-129 * var(--px));
    width: calc(389 * var(--px)); height: calc(389 * var(--px)); border-radius: 50%;
    background: #76b9ff; opacity: 0.26; filter: blur(calc(60 * var(--px)));
  }
  .card--edu__band {
    position: absolute; left: 0; right: 0; top: calc(159 * var(--px)); height: calc(228 * var(--px));
    background: rgba(255,255,255,0.04);
  }
  .edu__block { position: relative; font-size: calc(27 * var(--px)); line-height: 1.52; }
  .edu__block--1 { margin-top: calc(35 * var(--px)); }
  .edu__block b { font-weight: 700; }
  .edu__degree { max-width: calc(345 * var(--px)); }
  .edu__rule {
    position: relative; border: 0; height: calc(2 * var(--px)); background: #fff;
    width: calc(560 * var(--px)); margin: calc(40 * var(--px)) 0 calc(40 * var(--px)) calc(16 * var(--px));
  }

  /* Skills */
  .card--skills { background: var(--skills-bg); padding-left: calc(56 * var(--px)); }
  .skills__group h4 {
    display: flex; align-items: center; gap: calc(10 * var(--px));
    font-size: calc(27 * var(--px)); font-weight: 700; line-height: 1.5;
    margin-left: calc(-30 * var(--px)) ;
  }
  .skills__group h4 i { width: calc(20 * var(--px)); height: calc(20 * var(--px)); border-radius: 50%; background: var(--blue); }
  .skills__group--soft { margin-top: calc(39 * var(--px)); }
  .skills__group ul {
    display: flex; flex-wrap: wrap; gap: calc(16 * var(--px)) calc(15 * var(--px));
    margin: calc(10 * var(--px)) 0 0 calc(-22 * var(--px)); padding: 0; list-style: none;
    max-width: calc(530 * var(--px));
  }
  .skills__group li {
    width: calc(var(--cw) * var(--px)); text-align: center; white-space: nowrap;
    padding: calc(4 * var(--px)) 0;
    border-radius: calc(15 * var(--px)); background: #fff;
    color: var(--blue); font-size: calc(15 * var(--px)); line-height: 1.53;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .skills__group li:hover { background: var(--blue); color: #fff; }
  .skills__rule { border: 0; height: calc(2 * var(--px)); background: var(--blue); width: calc(451 * var(--px)); margin: calc(52 * var(--px)) 0 calc(40 * var(--px)) calc(4 * var(--px)); }
  .about__cursor { --d: 700ms; }

  /* Tools */
  .card--tools { background: #10182b; color: #fff; }
  .tools__glow { position: absolute; width: calc(236 * var(--px)); height: calc(236 * var(--px)); border-radius: 50%; background: #19395f; filter: blur(calc(65 * var(--px))); }
  .tools__glow--a { left: calc(346 * var(--px)); top: calc(42 * var(--px)); }
  .tools__glow--b { left: calc(-87 * var(--px)); top: calc(518 * var(--px)); }
  .tools {
    position: relative; display: grid; grid-template-columns: repeat(2, calc(190 * var(--px)));
    gap: calc(14 * var(--px)) calc(14 * var(--px)); margin: calc(34 * var(--px)) 0 0; padding: 0; list-style: none;
  }
  .tool {
    height: calc(160 * var(--px)); border-radius: calc(20 * var(--px));
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: calc(10 * var(--px));
    background: rgba(255,255,255,0.06);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.10), inset 1px 1px 0 rgba(255,255,255,0.12);
    font-size: calc(15 * var(--px));
    transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .tool img { width: calc(90 * var(--px)); height: calc(90 * var(--px)); }
  .tool__round { border-radius: 30%; }
  .tool:hover { transform: translateY(calc(-6 * var(--px))); background: rgba(255,255,255,0.12); }

  @media (max-width: 1099px) {
    .about { display: grid; gap: 18px; grid-template-columns: 1fr; }
    @media (min-width: 700px) { .about { grid-template-columns: 1fr 1fr; } .about > :first-of-type, #about-title { grid-column: 1 / -1; } }
    .about__glow { left: auto; right: -40vw; top: -30vw; width: 80vw; height: 80vw; filter: blur(80px); }
    .card { border-radius: 28px; padding: 30px 26px 34px; }
    .card__title { font-size: 32px; }
    .edu__block { font-size: 17px; }
    .edu__degree { max-width: none; }
    .card--edu__glow { left: auto; right: -80px; top: -90px; width: 220px; height: 220px; filter: blur(50px); }
    .card--edu__band { top: 92px; height: 170px; }
    .edu__block--1 { margin-top: 20px; }
    .edu__rule { width: 100%; margin: 26px 0; height: 1px; }
    .card--skills { padding-left: 46px; }
    .skills__group h4 { font-size: 18px; gap: 8px; margin-left: -22px; }
    .skills__group h4 i { width: 12px; height: 12px; }
    .skills__group--soft { margin-top: 18px; }
    .skills__group ul { gap: 10px 8px; margin: 12px 0 0 -16px; max-width: none; }
    .skills__group li { width: auto; font-size: 14px; padding: 6px 14px; border-radius: 16px; }
    .skills__rule { width: 100%; height: 1px; margin: 26px 0; }
    .about__cursor { display: none; }
    .tools { grid-template-columns: repeat(3, minmax(0, 120px)); gap: 10px; margin-top: 20px; }
    .tool { height: auto; aspect-ratio: 1 / 0.85; font-size: 13px; border-radius: 16px; gap: 8px; }
    .tool img { width: 46px; height: 46px; }
    .tools__glow { width: 160px; height: 160px; filter: blur(50px); }
    .tools__glow--a { left: auto; right: -40px; top: -20px; }
    .tools__glow--b { left: -50px; top: auto; bottom: -50px; }
  }
  @media (max-width: 420px) { .tools { grid-template-columns: repeat(2, 1fr); } }
</style>
