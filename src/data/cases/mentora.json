nter", "resize": "H", "size": 25, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 25, "color": "#ffffff", "lh": "a", "ls": 0, "text": "SOLUTION"}], "list": false}], "card": 2}, {"x": 112, "y": 331, "w": 135, "h": 192, "align": "center", "resize": "H", "size": 128, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 128, "color": "#1d59bb", "lh": "a", "ls": 0, "text": "01"}], "list": false}], "card": 0}, {"x": 710, "y": 331, "w": 158, "h": 192, "align": "center", "resize": "H", "size": 128, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 128, "color": "#1d59bb", "lh": "a", "ls": 0, "text": "02"}], "list": false}], "card": 1}, {"x": 1316, "y": 331, "w": 163, "h": 192, "align": "center", "resize": "H", "size": 128, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 128, "color": "#ffffff", "lh": "a", "ls": 0, "text": "03"}], "list": false}], "card": 2}, {"x": 114, "y": 575, "w": 472, "h": 145, "align": "left", "resize": "H", "size": 19, "lines": [{"runs": [{"fam": "Poppins", "w": 400, "it": false, "size": 19, "color": "#000000", "lh": "a", "ls": 0, "text": "People with Colour Vision Deficiency (CVD) discover career restrictions only after years of education and preparation. There is no problem that maps careers by colour dependency or provides CVD specific guidance at the right time."}], "list": false}], "card": 0}, {"x": 724, "y": 575, "w": 472, "h": 145, "align": "left", "resize": "H", "size": 19, "lines": [{"runs": [{"fam": "Poppins", "w": 400, "it": false, "size": 19, "color": "#000000", "lh": "a", "ls": 0, "text": "CVD typically discovered when a job fitness test rejects someone after years of effort. It results in irreversible career loss, emotional distress, anxiety, and forced compromise not because of ability, but because of a systemic design error."}], "list": false}], "card": 1}, {"x": 1333, "y": 575, "w": 472, "h": 145, "align": "left", "resize": "H", "size": 19, "lines": [{"runs": [{"fam": "Poppins", "w": 400, "it": false, "size": 19, "color": "#ffffff", "lh": "a", "ls": 0, "text": "Mentora a CVD aware career guidance app that helps individuals identify colour dependent career risks, explore ability matched alternatives, and access expert support so career decisions are informed."}], "list": false}], "card": 2}], "cards": [{"x": 61, "y": 270, "w": 579, "h": 540, "fill": "#dde6f5", "op": 1.0}, {"x": 670, "y": 270, "w": 579, "h": 540, "fill": "#dde6f5", "op": 1.0}, {"x": 1280, "y": 270, "w": 579, "h": 540, "fill": "#1d59bb", "op": 1.0}, {"x": 1021, "y": 161, "w": 412, "h": 80, "fill": "#ffffff", "op": 1.0}, {"x": 1053, "y": 182, "w": 349, "h": 147, "fill": "#b6c4f2", "op": 0.3}, {"x": 1054, "y": 407, "w": 349, "h": 175, "fill": "#fff6d9", "op": 1.0}], "images": []}, {"id": "26", "h": 1080, "visual": false, "bg": "#ffffff", "title": "Research", "nodes": [{"x": 50, "y": 50, "w": 376, "h": 90, "align": "center", "resize": "H", "size": 60, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 60, "color": "#000000", "lh": "a", "ls": 0, "text": "Research"}], "list": false}], "card": null}, {"x": 19, "y": 149, "w": 298, "h": 38, "align": "center", "resize": "H", "size": 25, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 25, "color": "#1d59bb", "lh": "a", "ls": 0, "text": "Secondary research"}], "list": false}], "card": null}, {"x": 1426, "y": 141, "w": 428, "h": 38, "align": "center", "resize": "H", "size": 25, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 25, "color": "#1d59bb", "lh": "a", "ls": 0, "text": "Affects on individuals life"}], "list": false}], "card": 0}, {"x": 109, "y": 275, "w": 298, "h": 38, "align": "left", "resize": "H", "size": 25, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 25, "color": "#1d59bb", "lh": "a", "ls": 0, "text": "What is CVD ?"}], "list": false}], "card": null}, {"x": 109, "y": 328, "w": 783, "h": 87, "align": "left", "resize": "H", "size": 19, "lines": [{"runs": [{"fam": "Poppins", "w": 400, "it": false, "size": 19, "color": "#000000", "lh": "a", "ls": 0, "text": "Colour Vision Deficiency commonly known as colour blindness occurs when light-sensitive cone cells in the retina fail to respond properly to colour variations. "}], "list": false}, {"runs": [{"fam": "Poppins", "w": 400, "it": false, "size": 19, "color": "#000000", "lh": "a", "ls": 0, "text": "Most commonly affects perception of red and green shades"}], "list": false}], "card": null}, {"x": 1073, "y": 276, "w": 298, "h": 38, "align": "left", "resize": "H", "size": 25, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 25, "color": "#1d59bb", "lh": "a", "ls": 0, "text": "Everyday"}], "list": false}], "card": 2}, {"x": 1073, "y": 318, "w": 644, "h": 58, "align": "left", "resize": "H", "size": 19, "lines": [{"runs": [{"fam": "Poppins", "w": 400, "it": false, "size": 19, "color": "#000000", "lh": "a", "ls": 0, "text": "Difficulty judging food ripeness, matching clothing, noticing bruises/rashes, reading traffic signals in poor lighting"}], "list": false}], "card": 2}, {"x": 1073, "y": 456, "w": 298, "h": 38, "align": "left", "resize": "H", "size": 25, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 25, "color": "#1d59bb", "lh": "a", "ls": 0, "text": "Digital"}], "list": false}], "card": 4}, {"x": 1073, "y": 498, "w": 644, "h": 58, "align": "left", "resize": "H", "size": 19, "lines": [{"runs": [{"fam": "Poppins", "w": 400, "it": false, "size": 19, "color": "#000000", "lh": "a", "ls": 0, "text": "Charts, dashboards, error messages and status indicators using colour-only cues cause confusion"}], "list": false}], "card": 4}, {"x": 1073, "y": 636, "w": 298, "h": 38, "align": "left", "resize": "H", "size": 25, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 25, "color": "#1d59bb", "lh": "a", "ls": 0, "text": "Emotional"}], "list": false}], "card": 6}, {"x": 1073, "y": 678, "w": 644, "h": 58, "align": "left", "resize": "H", "size": 19, "lines": [{"runs": [{"fam": "Poppins", "w": 400, "it": false, "size": 19, "color": "#000000", "lh": "a", "ls": 0, "text": "Low confidence, anxiety, embarrassment, avoidance of colour-based tasks, social discomfort"}], "list": false}], "card": 6}, {"x": 1073, "y": 816, "w": 298, "h": 38, "align": "left", "resize": "H", "size": 25, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 25, "color": "#1d59bb", "lh": "a", "ls": 0, "text": "Career"}], "list": false}], "card": 8}, {"x": 1073, "y": 858, "w": 644, "h": 58, "align": "left", "resize": "H", "size": 19, "lines": [{"runs": [{"fam": "Poppins", "w": 400, "it": false, "size": 19, "color": "#000000", "lh": "a", "ls": 0, "text": "Certain professions are inaccessible due to colour vision requirements , late discovery comes after years of preparation"}], "list": false}], "card": 8}, {"x": 109, "y": 526, "w": 298, "h": 38, "align": "left", "resize": "H", "size": 25, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 25, "color": "#1d59bb", "lh": "a", "ls": 0, "text": "Who is affected?"}], "list": false}], "card": null}, {"x": 109, "y": 579, "w": 783, "h": 87, "align": "left", "resize": "H", "size": 19, "lines": [{"runs": [{"fam": "Poppins", "w": 400, "it": false, "size": 19, "color": "#000000", "lh": "a", "ls": 0, "text": "1 in 12 men · 1 in 200 women. Mostly congenital (X-linked), can also be acquired through disease, medication or aging."}], "list": false}, {"runs": [{"fam": "Poppins", "w": 400, "it": false, "size": 19, "color": "#000000", "lh": "a", "ls": 0, "text": "Red-green deficiency is the most common worldwide"}], "list": false}], "card": null}, {"x": 108, "y": 775, "w": 298, "h": 38, "align": "left", "resize": "H", "size": 25, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 25, "color": "#1d59bb", "lh": "a", "ls": 0, "text": "Beliefs vs Reality"}], "list": false}], "card": null}, {"x": 108, "y": 828, "w": 783, "h": 87, "align": "left", "resize": "H", "size": 19, "lines": [{"runs": [{"fam": "Poppins", "w": 400, "it": false, "size": 19, "color": "#000000", "lh": "a", "ls": 0, "text": "No current solution corrects congenital CVD. Filters and \"colour-correcting\" lenses are assistive at best , not cures."}], "list": false}, {"runs": [{"fam": "Poppins", "w": 400, "it": false, "size": 19, "color": "#000000", "lh": "a", "ls": 0, "text": "Focus must shift from \"fixing the individual\" to designing inclusive systems."}], "list": false}], "card": null}], "cards": [{"x": 1410, "y": 115, "w": 460, "h": 89, "fill": "#fff7ca", "op": 1.0}, {"x": 1015, "y": 256, "w": 533, "h": 140, "fill": "#1d59bb", "op": 1.0}, {"x": 1033, "y": 256, "w": 837, "h": 140, "fill": "#dde6f5", "op": 1.0}, {"x": 1015, "y": 436, "w": 533, "h": 140, "fill": "#1d59bb", "op": 1.0}, {"x": 1033, "y": 436, "w": 837, "h": 140, "fill": "#dde6f5", "op": 1.0}, {"x": 1015, "y": 616, "w": 533, "h": 140, "fill": "#1d59bb", "op": 1.0}, {"x": 1033, "y": 616, "w": 837, "h": 140, "fill": "#dde6f5", "op": 1.0}, {"x": 1015, "y": 796, "w": 533, "h": 140, "fill": "#1d59bb", "op": 1.0}, {"x": 1033, "y": 796, "w": 837, "h": 140, "fill": "#dde6f5", "op": 1.0}], "images": []}, {"id": "27", "h": 1080, "visual": false, "bg": "#ffffff", "title": "Research", "nodes": [{"x": 50, "y": 50, "w": 376, "h": 90, "align": "center", "resize": "H", "size": 60, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 60, "color": "#000000", "lh": "a", "ls": 0, "text": "Research"}], "list": false}], "card": null}, {"x": 19, "y": 149, "w": 262, "h": 38, "align": "center", "resize": "H", "size": 25, "lines": [{"runs": [{"fam": "Poppins", "w": 700, "it": false, "size": 25, "color": "#1d59bb", "lh": "a", "ls": 0, "text": "Primary research"}], "list": false}], "card": null}, {"x": 1365, "y": 767, "w": 270, "h": 87, "align": "left", "resize": "H", "size": 19, "lines": [{"runs": [{"fam": "Poppins", "w": 400, "it": false, "size